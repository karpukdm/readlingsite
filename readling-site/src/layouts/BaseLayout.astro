---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  keywords?: string;
}

const {
  title,
  description,
  canonicalPath = '',
  ogImage = '/og-default.png',
  ogType = 'website',
  noindex = false,
  keywords,
} = Astro.props;

const path = canonicalPath && !canonicalPath.endsWith('/') ? canonicalPath + '/' : canonicalPath;
const canonicalURL = new URL(path, Astro.site);
const ogImageURL = ogImage.startsWith('http') ? ogImage : new URL(ogImage, Astro.site).toString();

// Подтверждение прав в Search Console, Яндекс.Вебмастере и Bing Webmaster Tools.
// Задаётся переменными сборки (см. .env.example) — без них мету просто не выводим.
const verification = import.meta.env.PUBLIC_GSC_VERIFICATION;
const yandexVerification = import.meta.env.PUBLIC_YANDEX_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_VERIFICATION;
---

<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#007AFF" />
  <meta name="format-detection" content="telephone=no" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <meta name="author" content="Readling" />
  {/* `follow` и на noindex-страницах: они остаются частью навигации, и ссылки
      с них должны передавать вес дальше по каталогу. `nofollow` обрывал бы обход. */}
  {noindex
    ? <meta name="robots" content="noindex, follow" />
    : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
  {verification && <meta name="google-site-verification" content={verification} />}
  {yandexVerification && <meta name="yandex-verification" content={yandexVerification} />}
  {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
  <link rel="canonical" href={canonicalURL} />
  <link rel="alternate" hreflang="ru" href={canonicalURL} />
  <link rel="alternate" hreflang="x-default" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:site_name" content="Readling" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <!-- Preconnect to image CDN to speed up book covers -->
  <link rel="preconnect" href="https://storage.yandexcloud.net" crossorigin />
  <link rel="dns-prefetch" href="https://storage.yandexcloud.net" />

  <link rel="icon" type="image/x-icon" href={new URL('/favicon.ico', Astro.site).toString()} sizes="any" />
  <link rel="shortcut icon" type="image/x-icon" href={new URL('/favicon.ico', Astro.site).toString()} />
  <link rel="icon" type="image/svg+xml" href={new URL('/favicon.svg', Astro.site).toString()} />
  <link rel="icon" type="image/png" sizes="120x120" href={new URL('/favicon-120x120.png', Astro.site).toString()} />
  <link rel="icon" type="image/png" sizes="192x192" href={new URL('/favicon.png', Astro.site).toString()} />
  <link rel="apple-touch-icon" sizes="180x180" href={new URL('/apple-touch-icon.png', Astro.site).toString()} />
  <link rel="manifest" href="/site.webmanifest" />

  <slot name="head" />

  <Analytics />
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />

  <slot name="schema" />
</body>
</html>
