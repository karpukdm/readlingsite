---
import { links } from '../config/links';
const currentYear = new Date().getFullYear();
---

<footer class="footer" id="download">
  <!-- CTA Section -->
  <div class="footer-cta">
    <div class="container text-center">
      <h2 class="mb-m">Начните читать на английском прямо сейчас</h2>
      <p class="mb-l max-w-prose mx-auto">Скачайте Readling — 7 дней премиума в подарок, без автосписаний</p>
      <div class="store-buttons" style="justify-content: center;">
        <a href={links.appStore} target="_blank" rel="noopener" class="store-btn"><img src="/badge-appstore.svg" alt="Загрузите в App Store" /></a>
        <a href={links.googlePlay} target="_blank" rel="noopener" class="store-btn store-btn--google"><img src="/badge-google-play.png" alt="Доступно в Google Play" /></a>
      </div>
      <div class="qr-code">
        <a href={links.onelink} target="_blank" rel="noopener">
          <img src="/qr-code.gif" width="132" height="132" alt="QR-код для скачивания Readling" />
        </a>
        <p class="qr-code__hint">Наведите камеру, чтобы скачать</p>
      </div>
    </div>
  </div>

  <!-- Footer Links -->
  <div class="footer-links">
    <div class="container footer-links__inner">
      <div class="footer-col footer-col--brand">
        <a href="/" class="footer__logo">
          <picture>
            <source srcset="/logo.webp" type="image/webp" />
            <img src="/logo.png" alt="Readling" class="footer__logo-icon" width="32" height="32" loading="lazy" decoding="async" />
          </picture>
          Readling
        </a>
        <p class="footer__desc">Приложение для изучения английского через чтение книг</p>
        <a href={links.telegram} target="_blank" rel="noopener" class="footer-tg" data-tg="footer">
          <span class="footer-tg__icon"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M9.78 18.65l.28-4.23 7.68-6.92c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.33 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71L12.6 16.3l-1.99 1.93c-.23.23-.42.42-.83.42z"/></svg></span>
          <span class="footer-tg__text">
            <span class="footer-tg__title">Readling в Telegram</span>
            <span class="footer-tg__sub">Новые книги и функции — узнавайте первыми</span>
          </span>
        </a>
      </div>
      <div class="footer-col">
        <h2 class="footer-col__title">Возможности</h2>
        <a href="/books/">Каталог книг</a>
        <a href="/metod-pogruzheniya/">Метод погружения</a>
        <a href="/parallelnoe-chtenie/">Параллельное чтение</a>
        <a href="/grammatika/">Упражнения по грамматике</a>
        <a href="/razgovornaya-praktika/">Разговорная практика</a>
        <a href="/sravnenie/readling-vs-duolingo/">Readling vs Duolingo</a>
      </div>
      <div class="footer-col">
        <h2 class="footer-col__title">По уровням</h2>
        <a href="/uroven/a1/">Английский A1 — для начинающих</a>
        <a href="/uroven/a2/">Английский A2</a>
        <a href="/uroven/b1/">Английский B1</a>
        <a href="/uroven/b2/">Английский B2</a>
        <a href="/uroven/c1/">Английский C1</a>
        <a href="/uroven/c2/">Английский C2</a>
      </div>
      <div class="footer-col">
        <h2 class="footer-col__title">Информация</h2>
        <a href="/o-readling/">О Readling</a>
        <a href="https://readling.notion.site/Privacy-Policy-28905c6ed51e80ceb8cafbd84d6eeb42?pvs=74" target="_blank" rel="noopener">Конфиденциальность</a>
        <a href="https://readling.notion.site/Terms-of-Use-2d405c6ed51e80d3b5f2cf3ed237b3ec" target="_blank" rel="noopener">Условия использования</a>
        <a href={links.support} target="_blank" rel="noopener">Поддержка</a>
        <a href="/pravoobladatelyam/">Правообладателям</a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>&copy; {currentYear} Readling. Все права защищены.</p>
    </div>
  </div>
</footer>

<style>
  .footer-cta {
    background: var(--color-primary);
    color: var(--color-on-primary);
    padding: var(--space-xxl) 0;
  }

  .footer-cta h2 {
    color: var(--color-on-primary);
  }

  .footer-cta p {
    color: rgba(255, 255, 255, 0.85);
  }

  .qr-code {
    margin-top: var(--space-l);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-s);
  }

  .qr-code img {
    border-radius: var(--radius-sm);
    background: white;
    padding: 4px;
  }

  .qr-code__hint {
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.7);
  }

  @media (max-width: 768px) {
    .qr-code {
      display: none;
    }
  }

  .footer-links {
    background: var(--color-surface);
    padding: var(--space-xl) 0 var(--space-l);
    border-top: 1px solid var(--color-card-border);
  }

  .footer-links__inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-xl);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .footer-col--brand {
    grid-row: span 1;
  }

  .footer-col__title {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-xs);
  }

  .footer-col a {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .footer-col a:hover {
    color: var(--color-primary);
  }

  .footer__logo {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .footer__logo:hover {
    color: var(--color-text);
  }

  .footer__logo-icon {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    object-fit: cover;
  }

  .footer-tg {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-s);
    padding: var(--space-s) var(--space-m) var(--space-s) var(--space-s);
    max-width: 320px;
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color var(--duration-fast) var(--ease-out), background var(--duration-fast) var(--ease-out);
  }

  .footer-tg:hover {
    border-color: var(--color-primary);
    background: var(--color-primary-tint);
  }

  .footer-tg__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #2AABEE;
    color: #fff;
  }

  .footer-tg__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .footer-col a.footer-tg .footer-tg__title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .footer-tg__sub {
    font-size: 0.8125rem;
    color: var(--color-text-tertiary);
    line-height: 1.35;
  }

  .footer__desc {
    font-size: 0.875rem;
    color: var(--color-text-tertiary);
    line-height: 1.5;
    max-width: 280px;
  }

  .footer-bottom {
    background: var(--color-surface);
    border-top: 1px solid var(--color-card-border);
    padding: var(--space-m) 0;
  }

  .footer-bottom p {
    font-size: 0.8125rem;
    color: var(--color-text-tertiary);
  }

  @media (max-width: 768px) {
    .footer-links__inner {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .footer-links__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
