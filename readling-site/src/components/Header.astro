---
import { links } from '../config/links';
// Подписи короче, чем заголовки самих страниц, и это вынужденно: семь пунктов
// полными названиями не помещаются в ряд даже на 1440px. Сокращаем так, чтобы
// ключевое слово осталось в тексте ссылки («погружение», «Duolingo»), — иначе
// теряется и якорь, и узнаваемость раздела. Ряду нужно 938px, поэтому ниже
// 1025px он целиком уходит в бургер (см. медиазапрос в стилях).
const navItems = [
  { href: '/books/', label: 'Книги' },
  { href: '/metod-pogruzheniya/', label: 'Погружение' },
  { href: '/parallelnoe-chtenie/', label: 'Параллельное чтение' },
  { href: '/grammatika/', label: 'Грамматика' },
  { href: '/razgovornaya-praktika/', label: 'Чат с героями' },
  { href: '/sravnenie/readling-vs-duolingo/', label: 'vs Duolingo' },
  { href: '/pricing/', label: 'Цены' },
];
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="header__logo">
      <picture>
        <source srcset="/logo.webp" type="image/webp" />
        <img src="/logo.png" alt="Readling" class="header__logo-icon" width="32" height="32" decoding="async" />
      </picture>
      <span class="header__logo-text">Readling</span>
    </a>
    <nav class="header__nav" id="nav">
      {navItems.map(item => (
        <a href={item.href} class="header__link">{item.label}</a>
      ))}
      {/* В бургер-меню — текстом; на широком экране вместо него иконка у «Скачать». */}
      <a href={links.telegram} target="_blank" rel="noopener" class="header__link header__link--tg" data-tg="menu">Наш Telegram-канал</a>
    </nav>
    <a href={links.telegram} target="_blank" rel="noopener" class="header__tg" data-tg="header" aria-label="Readling в Telegram" title="Readling в Telegram"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor"><path d="M9.78 18.65l.28-4.23 7.68-6.92c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.33 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71L12.6 16.3l-1.99 1.93c-.23.23-.42.42-.83.42z"/></svg></a>
    <a href="#download" class="btn btn--primary header__cta" id="header-cta">Скачать</a>
    {/* На компьютере кнопка прокручивает к подвалу: там обе кнопки магазинов
        и QR-код для телефона. С телефона ведём на /download/, которая сразу
        открывает нужный магазин. Определение устройства то же, что в
        src/pages/download.astro, — меняя одно, поменяйте и другое. */}
    <script is:inline>
      (function () {
        var ua = navigator.userAgent;
        var isIOS = /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
        if (isIOS || /Android/.test(ua)) document.getElementById('header-cta').href = '/download/';
      })();
    </script>
    <button class="header__burger" id="burger" aria-label="Открыть меню">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(245, 245, 247, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--color-card-border);
    height: var(--header-height);
  }



  .header__inner {
    display: flex;
    align-items: center;
    height: 100%;
    gap: var(--space-l);
  }

  .header__logo {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    text-decoration: none;
    color: var(--color-text);
    font-weight: 700;
    font-size: 1.125rem;
    flex-shrink: 0;
  }

  .header__logo:hover {
    color: var(--color-text);
  }

  .header__logo-icon {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    object-fit: cover;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    margin-left: auto;
  }

  .header__link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    white-space: nowrap;
  }

  .header__link:hover {
    color: var(--color-primary);
  }

  .header__link--tg {
    display: none;
  }

  .header__tg {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    margin-right: calc(-1 * var(--space-s));
    flex-shrink: 0;
    border-radius: 50%;
    color: var(--color-text-tertiary);
    transition: color var(--duration-fast) var(--ease-out), background var(--duration-fast) var(--ease-out);
  }

  .header__tg:hover {
    color: #2AABEE;
    background: rgba(42, 171, 238, 0.1);
  }

  .header__cta {
    min-height: 40px;
    padding: var(--space-s) var(--space-m);
    font-size: 0.875rem;
    flex-shrink: 0;
  }

  .header__burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-s);
  }

  .header__burger span {
    width: 20px;
    height: 2px;
    background: var(--color-text);
    border-radius: 1px;
    transition: all var(--duration-fast) var(--ease-out);
  }

  @media (max-width: 1024px) {
    .header__nav {
      display: none;
      position: absolute;
      top: var(--header-height);
      left: 0;
      right: 0;
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-card-border);
      flex-direction: column;
      padding: var(--space-m) var(--space-l);
      gap: var(--space-m);
    }

    .header__nav.open {
      display: flex;
    }

    .header__cta,
    .header__tg {
      display: none;
    }

    .header__link--tg {
      display: block;
    }

    .header__burger {
      display: flex;
      margin-left: auto;
    }
  }
</style>

<script>
  const burger = document.getElementById('burger');
  const nav = document.getElementById('nav');
  burger?.addEventListener('click', () => {
    nav?.classList.toggle('open');
  });
</script>
