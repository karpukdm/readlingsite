---
import BaseLayout from '../layouts/BaseLayout.astro';
import { links } from '../config/links';
import { pickByHash, coverPath, coverSrcset } from '../utils/slug';
import { indexableCatalog, appCatalog } from '../utils/catalog';
import Faq from '../components/Faq.astro';

// Витрину набираем только из индексируемых страниц: рекламировать с главной то,
// что закрыто от индексации, — значит вести пользователя в тупик каталога.
// Восемь, а не двенадцать: полка переехала на третье место и попала в порог
// ленивой загрузки Chromium, то есть все обложки грузятся до первого скролла.
// На 1440px в ряд видно семь, так что восьмая ещё и намекает на прокрутку.
const featuredBooks = pickByHash(indexableCatalog, 8, 'home-featured-v1');

// Вопросы и ответы. Массив один: из него печатается и видимый блок, и разметка
// FAQPage (см. components/Faq.astro). Раньше их писали порознь, и текст в схеме
// разошёлся с текстом на странице.
const faqItems = [
  {
    q: 'Для какого уровня английского подходит Readling?',
    a: 'Для любого — от полного начинающего (A1) до продвинутого (C2). В каталоге есть книги для каждого уровня, а режим погружения адаптирует сложность текста под вас.',
  },
  {
    q: 'Что такое режим погружения?',
    a: 'Это уникальный способ чтения, при котором английские слова и фразы постепенно появляются в русском тексте. Вы начинаете читать почти на русском, а к концу книги — уже на английском. Переход происходит плавно и незаметно.',
  },
  {
    q: 'Можно ли пользоваться Readling бесплатно?',
    a: 'Да, бесплатная версия даёт доступ к части каталога. Подписка открывает все книги, убирает рекламу и даёт доступ ко всем функциям. Первые 7 дней — бесплатно.',
  },
  {
    q: 'Какие книги есть в каталоге?',
    a: `${appCatalog.books} книг в ${appCatalog.genres} жанрах: детективы, фантастика, классика, романтика, научпоп и другие. Часть книг доступна в режиме параллельного чтения, часть — в режиме погружения. У каждой книги в каталоге указан её режим.`,
  },
  {
    q: 'Как работают тренировки?',
    a: 'Когда вы читаете и нажимаете на незнакомое слово, оно сохраняется в ваш личный словарь. Тренировки — флэш-карточки, пазлы предложений, вставка слов — помогают запомнить именно ваши слова, а не случайные из учебника.',
  },
  {
    q: 'На каких устройствах работает Readling?',
    a: 'На iPhone и Android-смартфонах, а также на iPad и Android-планшетах — там параллельное чтение показывается двумя колонками. Скачайте бесплатно из App Store или Google Play.',
  },
];
---

<BaseLayout
  title="Readling — книги на английском с переводом для изучения языка"
  description={`Читайте книги на английском с русским переводом: оригинал и перевод рядом либо плавное погружение. ${appCatalog.books} книг от A1 до C2. Первые 7 дней бесплатно.`}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/screen-parallel-280.webp" type="image/webp" fetchpriority="high"
          imagesrcset="/screen-parallel-280.webp 280w, /screen-parallel-560.webp 560w, /screen-parallel.webp 834w" imagesizes="280px" />
  </Fragment>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__content">
        <span class="badge mb-m">7 дней бесплатно</span>
        <h1 class="mb-m">Читайте книги на английском и понимайте с первой страницы</h1>
        <p class="hero__subtitle mb-l">
          <strong>Readling — приложение для чтения книг на английском с русским переводом.</strong>
          Незнакомое слово — нажмите, и перевод рядом. Слова остаются в памяти, потому что
          встретились в истории, а не в списке.
        </p>
        <div class="store-buttons mb-m">
          <a href={links.appStore} target="_blank" rel="noopener" class="store-btn"><img src="/badge-appstore.svg" alt="Загрузите в App Store" /></a>
          <a href={links.googlePlay} target="_blank" rel="noopener" class="store-btn store-btn--google"><img src="/badge-google-play.png" alt="Доступно в Google Play" /></a>
        </div>
        <ul class="proof-line">
          <li>{appCatalog.books} книг</li>
          <li>A1–C2</li>
          <li>iOS и Android</li>
        </ul>
      </div>
      {/* В герое параллельный режим: он самообъясняющийся (перевод рядом
          понятен без пояснений) и мажоритарный по каталогу — 61 запись против
          50 у погружения. Раньше здесь стоял неподписанный кадр погружения,
          и он читался как «вот и всё приложение»: посетитель видел русский
          текст с непонятными английскими вставками и решал, что ему это не
          подходит. Поэтому кадр подписан, а второй режим назван строкой ниже.
          Сам кадр в герое обязателен: без него страница не показывает продукт
          и объясняет механику раньше, чем сообщает, что это за приложение. */}
      <div class="hero__visual">
        <figure class="hero__shot">
          <picture>
            <source
              type="image/webp"
              srcset="/screen-parallel-280.webp 280w, /screen-parallel-560.webp 560w, /screen-parallel.webp 834w"
              sizes="280px"
            />
            <img src="/screen-parallel.png" alt="Экран чтения Readling: страница книги на английском, сверху — панель с русским переводом текущего фрагмента, сам фрагмент подсвечен в обоих текстах" width="834" height="1731" fetchpriority="high" decoding="async" />
          </picture>
          <figcaption class="hero__shot-label">Параллельный режим</figcaption>
        </figure>
        <p class="hero__modes-line">
          Есть и режим погружения — английский появляется в тексте постепенно.
          <a href="#modes">Сравнить оба →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- BOOK SHELF -->
  <section class="section">
    <div class="container">
      <div class="catalog-head">
        <div>
          <h2 class="mb-xs">Читайте то, что давно хотели — в оригинале</h2>
          {/* Без перечисления авторов: состав полки набирает pickByHash, и любой
              список имён в подписи начал бы врать молча при смене каталога.
              Имена и так видны на обложках прямо ниже. */}
          <p>{appCatalog.books} книг на английском с переводом — от A1 для начинающих до C2. Детективы, фантастика, классика, романтика.</p>
        </div>
        <a href="/books/" class="btn btn--secondary">Весь каталог →</a>
      </div>
      <div class="book-scroll">
        {featuredBooks.map(book => (
          <a href={`/books/${book.slug}/`} class="book-card">
            <img
              class="book-card__cover"
              src={coverPath(book.title, 'sm')}
              srcset={coverSrcset(book.title, 'card')}
              alt={`Обложка книги «${book.displayTitle}» — ${book.displayAuthor}, уровень ${book.level}`}
              loading="lazy"
              decoding="async"
              width="160"
              height="240"
            />
            <div class="book-card__title">{book.displayTitle}<span class="visually-hidden"> на английском с переводом</span></div>
            <div class="book-card__author">{book.displayAuthor}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- TWO MODES (equal) -->
  {/* tabindex="-1" — чтобы переход по якорю из героя переносил не только
      вьюпорт, но и фокус: иначе следующий Tab продолжает с прежнего места. */}
  <section class="section" id="modes" tabindex="-1">
    <div class="container">
      <div class="text-center mb-xl">
        <h2 class="mb-s">Книги на английском с переводом — два режима чтения</h2>
        <p class="max-w-prose mx-auto">
          В каталоге Readling — книги двух типов: одни в параллельном режиме (оригинал и перевод рядом), другие в режиме погружения. Выбирайте подход по уровню и стилю.
        </p>
      </div>
      <div class="modes-grid">
        <a href="/metod-pogruzheniya/" class="mode-card mode-card--immersion">
          <div class="mode-card__head">
            <span class="mode-card__icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                <circle cx="12" cy="12" r="9"/>
                <path d="M12 3 a9 9 0 0 1 0 18 z" fill="currentColor" stroke="none"/>
              </svg>
            </span>
            <span class="kicker">Режим погружения</span>
          </div>
          <h3 class="mode-card__title">Английский появляется в книге постепенно</h3>
          <p class="mode-card__text">
            Начало — почти всё на русском. С каждой страницей английских слов всё больше. К концу — вы читаете на английском.
          </p>
          <div class="mode-demo">
            <div class="mode-demo__row">
              <div class="mode-demo__head">
                <span class="mode-demo__label">Начало книги</span>
                <span class="mode-demo__pct">10% EN</span>
              </div>
              <div class="mode-demo__bar" style="--ratio: 10%"></div>
              <p>Анна <span class="en" lang="en">opened</span> дверь и <span class="en" lang="en">looked</span> на конверт.</p>
            </div>
            <div class="mode-demo__row">
              <div class="mode-demo__head">
                <span class="mode-demo__label">Середина</span>
                <span class="mode-demo__pct">50% EN</span>
              </div>
              <div class="mode-demo__bar" style="--ratio: 50%"></div>
              <p><span class="en" lang="en">Anna opened the door</span> и <span class="en" lang="en">looked at the envelope</span>.</p>
            </div>
            <div class="mode-demo__row">
              <div class="mode-demo__head">
                <span class="mode-demo__label">Конец книги</span>
                <span class="mode-demo__pct">90% EN</span>
              </div>
              <div class="mode-demo__bar" style="--ratio: 90%"></div>
              <p><span class="en" lang="en">Anna opened the door and looked at the envelope.</span></p>
            </div>
          </div>
          <span class="mode-card__link">Подробнее о методе погружения →</span>
        </a>

        <a href="/parallelnoe-chtenie/" class="mode-card mode-card--parallel">
          <div class="mode-card__head">
            <span class="mode-card__icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="5" width="7" height="14" rx="1.5"/>
                <rect x="14" y="5" width="7" height="14" rx="1.5"/>
                <path d="M10 9 h4 M10 12 h4 M10 15 h4"/>
              </svg>
            </span>
            <span class="kicker">Параллельный режим</span>
          </div>
          <h3 class="mode-card__title">Оригинал и русский перевод рядом</h3>
          <p class="mode-card__text">
            На планшете оригинал и перевод идут двумя колонками, абзац напротив абзаца. На телефоне — английский текст, а перевод текущего фрагмента показывается в панели над ним. Удобно сравнивать конструкции и проверять понимание.
          </p>
          <div class="parallel-demo">
            <div class="parallel-demo__col" lang="en">
              <span class="parallel-demo__badge">EN</span>
              <p>Anna opened the door and walked into the room.</p>
              <p>On the table lay a letter.</p>
              <p>She looked at the envelope and smiled.</p>
            </div>
            <div class="parallel-demo__col">
              <span class="parallel-demo__badge">RU</span>
              <p>Анна открыла дверь и вошла в комнату.</p>
              <p>На столе лежало письмо.</p>
              <p>Она посмотрела на конверт и улыбнулась.</p>
            </div>
          </div>
          <span class="mode-card__link">Подробнее о параллельном чтении →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- SUPPORTING FEATURES -->
  <section class="section section--alt">
    <div class="container">
      <div class="text-center mb-xl">
        <h2 class="mb-s">Умный перевод и тренировки на ваших словах</h2>
        <p class="max-w-prose mx-auto">
          Помимо самих режимов — два инструмента, которые помогают учить эффективнее.
        </p>
      </div>
      <div class="bento bento--2col">
        <div class="bento-tile">
          <span class="kicker">Умный перевод</span>
          <h3 class="bento-tile__title">Не дословно — а по смыслу</h3>
          <p class="bento-tile__text">
            Идиомы и фразовые глаголы переводятся так, как их понимает носитель — а не слово за словом.
          </p>
          <ul class="phrase-mini">
            <li>
              <span class="en" lang="en">It's raining cats and dogs</span>
              <span class="phrase-mini__good">Льёт как из ведра</span>
            </li>
            <li>
              <span class="en" lang="en">He kicked the bucket</span>
              <span class="phrase-mini__good">Он отдал концы</span>
            </li>
            <li>
              <span class="en" lang="en">She was over the moon</span>
              <span class="phrase-mini__good">Она была на седьмом небе</span>
            </li>
          </ul>
        </div>

        <div class="bento-tile">
          <span class="kicker">Тренировки</span>
          <h3 class="bento-tile__title">Закрепляйте слова из ваших книг</h3>
          <p class="bento-tile__text">
            Флэшкарточки, пазлы предложений и вставка слов — на словах, которые вы встретили в книге. Не списки из учебника, а ваш живой словарь.
          </p>
          {/* Плитка была пустой наполовину, рядом с наполненной соседкой это
              читалось как недоделка. Артефакт переиспользует `.phrase-mini`
              соседа — и показывает не названия тренировок (они уже в тексте
              выше), а то, что слова приходят из книг, которые вы читаете. */}
          <ul class="phrase-mini">
            <li>
              <span class="en" lang="en">envelope</span>
              <span class="phrase-mini__good">конверт</span>
              <span class="phrase-mini__src">из «Великого Гэтсби»</span>
            </li>
            <li>
              <span class="en" lang="en">withdrawn</span>
              <span class="phrase-mini__good">замкнутый</span>
              <span class="phrase-mini__src">из «Великого Гэтсби»</span>
            </li>
            <li>
              <span class="en" lang="en">daisy-chain</span>
              <span class="phrase-mini__good">венок из маргариток</span>
              <span class="phrase-mini__src">из «Алисы в Стране чудес»</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <Faq title="Частые вопросы о Readling" items={faqItems} />

  <!-- Schema.org -->
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Readling",
      "url": "https://readling.club/",
      "logo": "https://readling.club/logo.png",
      "description": "Мобильное приложение для изучения английского через чтение книг с режимом погружения и параллельным переводом.",
      "foundingDate": "2024",
      "sameAs": [
        "https://apps.apple.com/by/app/readling-%D0%B0%D0%BD%D0%B3%D0%BB%D0%B8%D0%B9%D1%81%D0%BA%D0%B8%D0%B9-%D0%BF%D0%BE-%D0%BA%D0%BD%D0%B8%D0%B3%D0%B0%D0%BC/id6752216664",
        "https://play.google.com/store/apps/details?id=com.karpukdm.readling",
        "https://t.me/readlingapp"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer support",
        "url": "https://t.me/readlingapp",
        "availableLanguage": ["Russian", "English"]
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Readling",
      "url": "https://readling.club/",
      "inLanguage": "ru",
      "description": "Изучение английского через чтение настоящих книг с режимом погружения и параллельным переводом."
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "MobileApplication",
      // Тот же @id, что на /pricing/ — одна сущность, описанная с двух страниц.
      "@id": "https://readling.club/#app",
      "name": "Readling — английский по книгам",
      "applicationCategory": "EducationalApplication",
      "operatingSystem": "iOS, Android",
      "description": "Приложение для изучения английского через чтение книг. Режим погружения, параллельное чтение, тренировки слов.",
      "url": "https://readling.club/",
      "image": "https://readling.club/logo.png",
      // Приложение freemium: бесплатный план и подписка. Один Offer с price "0"
      // противоречил бы /pricing/, где указано $3.99/мес.
      "offers": [
        {
          "@type": "Offer",
          "name": "Бесплатный план",
          "price": "0",
          "priceCurrency": "USD",
          "url": "https://readling.club/pricing/"
        },
        {
          "@type": "Offer",
          "name": "Подписка Premium",
          "price": "3.99",
          "priceCurrency": "USD",
          "url": "https://readling.club/pricing/"
        }
      ]
    })} />
  </Fragment>
</BaseLayout>

<style>
  .hero {
    background: var(--gradient-hero);
    padding: var(--space-xxl) 0;
    border-bottom: 1px solid var(--color-card-border);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .hero__subtitle {
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  /* ===== Скриншот в герое ===== */
  .hero__visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-m);
  }

  .hero__shot {
    position: relative;
    max-width: 280px;
    width: 100%;
  }

  .hero__shot img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-xxl);
    box-shadow: var(--shadow-lg);
  }

  /* Подпись поверх кадра: без неё кадр читался как «вот и всё приложение»,
     а под кадром её путали со строкой про второй режим. Сверху, а не снизу:
     на мобильном низ кадра уходит под сгиб, а сверху подпись ложится на
     статус-бар скриншота и не закрывает текст книги. */
  .hero__shot-label {
    position: absolute;
    left: 50%;
    top: var(--space-m);
    transform: translateX(-50%);
    padding: 6px var(--space-sm);
    border-radius: var(--radius-pill);
    background: rgba(28, 27, 31, 0.82);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: var(--color-on-primary);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    white-space: nowrap;
  }

  .hero__modes-line {
    max-width: 320px;
    font-size: 0.9375rem;
    line-height: 1.5;
    text-align: center;
    color: var(--color-text-secondary);
  }

  .hero__modes-line a {
    color: var(--color-primary-hover);
    font-weight: 600;
    white-space: nowrap;
  }

  /* ===== Proof line ===== */
  .proof-line {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-m);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
  }

  .proof-line li {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-weight: 500;
    position: relative;
    padding-left: var(--space-m);
  }

  .proof-line li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--color-text-tertiary);
    font-weight: 700;
  }

  .proof-line li:first-child {
    padding-left: 0;
  }

  .proof-line li:first-child::before {
    display: none;
  }

  /* ===== Kicker ===== */
  /* Не --color-primary: #007AFF даёт 3.7–4.0:1 на подложках карточек. */
  .kicker {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
