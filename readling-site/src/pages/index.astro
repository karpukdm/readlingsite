</BaseLayout>

<style>
  .hero {
    background: var(--gradient-hero);
    padding: var(--space-xxl) 0;
    border-bottom: 1px solid var(--color-card-border);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .hero__subtitle {
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .hero__phone {
    max-width: 280px;
    width: 100%;
    height: auto;
    border-radius: var(--radius-xxl);
    box-shadow: var(--shadow-lg);
    margin: 0 auto;
    display: block;
  }

  /* ===== Proof line ===== */
  .proof-line {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-m);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
  }

  .proof-line li {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-weight: 500;
    position: relative;
    padding-left: var(--space-m);
  }

  .proof-line li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--color-text-tertiary);
    font-weight: 700;
  }

  .proof-line li:first-child {
    padding-left: 0;
  }

  .proof-line li:first-child::before {
    display: none;
  }

  .proof-line__stars {
    color: var(--color-rating);
    letter-spacing: 1px;
  }

  /* ===== Kicker ===== */
  .kicker {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--color-primary);
    margin-bottom: var(--space-s);
  }

  .section--accent .kicker {
    color: rgba(255, 255, 255, 0.85);
  }

  /* ===== TWO MODES — equal cards ===== */
  .modes-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-l);
  }

  .mode-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-xl);
    padding: var(--space-xl);
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    transition: border-color var(--duration-normal) var(--ease-out), box-shadow var(--duration-normal) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }

  .mode-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--gradient-accent);
    opacity: 0.85;
  }

  .mode-card--immersion {
    background: linear-gradient(180deg, #F2F7FF 0%, #FFFFFF 60%);
  }

  .mode-card--parallel {
    background: linear-gradient(180deg, #FFF6EE 0%, #FFFFFF 60%);
  }

  .mode-card--parallel::before {
    background: linear-gradient(90deg, #FF9F40, #FF6B6B);
    opacity: 1;
  }

  .mode-card:hover {
    border-color: rgba(0, 122, 255, 0.3);
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
    color: inherit;
  }

  .mode-card__head {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    margin-bottom: var(--space-m);
  }

  .mode-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-pill);
    background: var(--color-primary-tint);
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .mode-card__icon svg {
    width: 20px;
    height: 20px;
  }

  .mode-card--parallel .mode-card__icon {
    background: rgba(255, 159, 64, 0.15);
    color: #FF8533;
  }

  .mode-card__head .kicker {
    margin-bottom: 0;
  }

  .mode-card--parallel .kicker {
    color: #FF8533;
  }

  .mode-card__title {
    font-size: 1.375rem;
    line-height: 1.25;
    margin-bottom: var(--space-s);
    letter-spacing: -0.2px;
  }

  .mode-card__text {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-l);
  }

  .mode-card__link {
    margin-top: auto;
    padding-top: var(--space-m);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .mode-card--parallel .mode-card__link {
    color: #FF6B6B;
  }

  /* ===== Immersion demo — progressive rows with bars ===== */
  .mode-demo {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-bottom: var(--space-m);
  }

  .mode-demo__row {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(4px);
    border: 1px solid rgba(0, 122, 255, 0.12);
    border-radius: var(--radius-md);
    padding: var(--space-sm) var(--space-m);
  }

  .mode-demo__head {
    display: flex;
    align-items: center;
