---
import BaseLayout from '../layouts/BaseLayout.astro';
import { links } from '../config/links';
import allBooks from '../data/books.json';
import { toSlug, complexityToLevel, pickByHash, coverPath, coverSrcset } from '../utils/slug';

const books = allBooks.filter(b => !b.title.includes('Guide') && !b.title.includes('Руководство'));
const featuredBooks = pickByHash(books, 12, 'home-featured-v1');
---

<BaseLayout
  title="Readling — учите английский язык, читая любимые книги"
  description="Изучение английского через чтение книг в приложении Readling. Режим плавного погружения, параллельное чтение, тренировки слов в контексте. 7 дней бесплатно."
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/screen-immersion.webp" type="image/webp" fetchpriority="high" />
  </Fragment>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__content">
        <span class="badge mb-m">7 дней бесплатно</span>
        <h1 class="mb-m">Учите английский через книги — легко, интересно, без зубрёжки</h1>
        <p class="hero__subtitle mb-l">
          <strong>Readling — мобильное приложение для изучения английского через чтение настоящих книг.</strong>
          Английский текст появляется в книге постепенно, слова запоминаются в контексте истории,
          а тренировки строятся на тех словах, которые вы встретили сами.
        </p>
        <div class="store-buttons mb-m">
          <a href={links.appStore} target="_blank" rel="noopener" class="store-btn"><img src="/badge-appstore.svg" alt="Загрузите в App Store" /></a>
          <a href={links.googlePlay} target="_blank" rel="noopener" class="store-btn store-btn--google"><img src="/badge-google-play.png" alt="Доступно в Google Play" /></a>
        </div>
        <ul class="proof-line">
          <li>100+ книг</li>
          <li>Уровни A1–C2</li>
          <li>iOS и Android</li>
        </ul>
      </div>
      <div class="hero__visual">
        <picture>
          <source srcset="/screen-immersion.webp" type="image/webp" />
          <img src="/screen-immersion.png" alt="Скриншот приложения Readling в режиме погружения: страница книги, где английские слова постепенно вплетаются в русский текст" class="hero__phone" width="834" height="1731" fetchpriority="high" decoding="async" />
        </picture>
      </div>
    </div>
  </section>

  <!-- TWO MODES (equal) -->
  <section class="section">
    <div class="container">
      <div class="text-center mb-xl">
        <h2 class="mb-s">Два режима чтения — выбирайте свой</h2>
        <p class="max-w-prose mx-auto">
          В каталоге Readling — книги двух типов: одни в параллельном режиме, другие в режиме погружения. Выбирайте подход по уровню и стилю.
        </p>
      </div>
      <div class="modes-grid">
        <a href="/metod-pogruzheniya/" class="mode-card mode-card--immersion">
          <div class="mode-card__head">
            <span class="mode-card__icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                <circle cx="12" cy="12" r="9"/>
                <path d="M12 3 a9 9 0 0 1 0 18 z" fill="currentColor" stroke="none"/>
              </svg>
            </span>
            <span class="kicker">Режим погружения</span>
          </div>
          <h3 class="mode-card__title">Английский появляется в книге постепенно</h3>
          <p class="mode-card__text">
            Начало — почти всё на русском. С каждой страницей английских слов всё больше. К концу — вы читаете на английском.
          </p>
          <div class="mode-demo">
            <div class="mode-demo__row">
              <div class="mode-demo__head">
                <span class="mode-demo__label">Начало книги</span>
                <span class="mode-demo__pct">10% EN</span>
              </div>
              <div class="mode-demo__bar" style="--ratio: 10%"></div>
              <p>Анна <span class="en" lang="en">opened</span> дверь и <span class="en" lang="en">looked</span> на конверт.</p>
            </div>
            <div class="mode-demo__row">
              <div class="mode-demo__head">
                <span class="mode-demo__label">Середина</span>
                <span class="mode-demo__pct">50% EN</span>
              </div>
              <div class="mode-demo__bar" style="--ratio: 50%"></div>
              <p><span class="en" lang="en">Anna opened the door</span> и <span class="en" lang="en">looked at the envelope</span>.</p>
            </div>
            <div class="mode-demo__row">
              <div class="mode-demo__head">
                <span class="mode-demo__label">Конец книги</span>
                <span class="mode-demo__pct">90% EN</span>
              </div>
              <div class="mode-demo__bar" style="--ratio: 90%"></div>
              <p><span class="en" lang="en">Anna opened the door and looked at the envelope.</span></p>
            </div>
          </div>
          <span class="mode-card__link">Подробнее о методе погружения →</span>
        </a>

        <a href="/parallelnoe-chtenie/" class="mode-card mode-card--parallel">
          <div class="mode-card__head">
            <span class="mode-card__icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="5" width="7" height="14" rx="1.5"/>
                <rect x="14" y="5" width="7" height="14" rx="1.5"/>
                <path d="M10 9 h4 M10 12 h4 M10 15 h4"/>
              </svg>
            </span>
            <span class="kicker">Параллельный режим</span>
          </div>
          <h3 class="mode-card__title">Оригинал и русский перевод рядом</h3>
          <p class="mode-card__text">
            Английский и русский текст параллельно — предложение за предложением. Удобно сравнивать конструкции и проверять понимание.
          </p>
          <div class="parallel-demo">
            <div class="parallel-demo__col" lang="en">
              <span class="parallel-demo__badge">EN</span>
              <p>Anna opened the door and walked into the room.</p>
              <p>On the table lay a letter.</p>
              <p>She looked at the envelope and smiled.</p>
            </div>
            <div class="parallel-demo__col">
              <span class="parallel-demo__badge">RU</span>
              <p>Анна открыла дверь и вошла в комнату.</p>
              <p>На столе лежало письмо.</p>
              <p>Она посмотрела на конверт и улыбнулась.</p>
            </div>
          </div>
          <span class="mode-card__link">Подробнее о параллельном чтении →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- SUPPORTING FEATURES -->
  <section class="section section--alt">
    <div class="container">
      <div class="text-center mb-xl">
        <h2 class="mb-s">Умный перевод и тренировки на ваших словах</h2>
        <p class="max-w-prose mx-auto">
          Помимо самих режимов — два инструмента, которые помогают учить эффективнее.
        </p>
      </div>
      <div class="bento bento--2col">
        <div class="bento-tile">
          <span class="kicker">Умный перевод</span>
          <h3 class="bento-tile__title">Не дословно — а по смыслу</h3>
          <p class="bento-tile__text">
            Идиомы и фразовые глаголы переводятся так, как их понимает носитель — а не слово за словом.
          </p>
          <ul class="phrase-mini">
            <li>
              <span class="en" lang="en">It's raining cats and dogs</span>
              <span class="phrase-mini__good">→ Льёт как из ведра</span>
            </li>
            <li>
              <span class="en" lang="en">He kicked the bucket</span>
              <span class="phrase-mini__good">→ Он отдал концы</span>
            </li>
          </ul>
        </div>

        <div class="bento-tile">
          <span class="kicker">Тренировки</span>
          <h3 class="bento-tile__title">Закрепляйте слова из ваших книг</h3>
          <p class="bento-tile__text">
            Флэшкарточки, пазлы предложений и вставка слов — на словах, которые вы встретили в книге. Не списки из учебника, а ваш живой словарь.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- BOOK CATALOG -->
  <section class="section">
    <div class="container">
      <div class="catalog-head">
        <div>
          <h2 class="mb-xs">100+ книг для любого уровня</h2>
          <p>От A1 для начинающих до C2 — детективы, фантастика, классика, романтика.</p>
        </div>
        <a href="/books/" class="btn btn--secondary">Весь каталог →</a>
      </div>
      <div class="book-scroll">
        {featuredBooks.map(book => (
          <a href={`/books/${toSlug(book.title)}/`} class="book-card">
            <img
              class="book-card__cover"
              src={coverPath(book.title, 'sm')}
              srcset={coverSrcset(book.title, 'card')}
              alt={`Обложка книги «${book.title}» — ${book.author}, уровень ${complexityToLevel[book.complexity]}`}
              loading="lazy"
              decoding="async"
              width="160"
              height="240"
            />
            <div class="book-card__title">{book.title}</div>
            <div class="book-card__author">{book.author}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container max-w-wide mx-auto">
      <h2 class="text-center mb-l">Частые вопросы о Readling</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary>Для какого уровня английского подходит Readling?</summary>
          <div class="faq-item__answer">
            Для любого — от полного начинающего (A1) до продвинутого (C2). В каталоге есть книги для каждого уровня,
            а режим погружения адаптирует сложность текста под вас.
          </div>
        </details>
        <details class="faq-item">
          <summary>Что такое режим погружения?</summary>
          <div class="faq-item__answer">
            Это уникальный способ чтения, при котором английские слова и фразы постепенно появляются в русском тексте.
            Вы начинаете читать почти на русском, а к концу книги — уже на английском. Переход происходит плавно и незаметно.
          </div>
        </details>
        <details class="faq-item">
          <summary>Можно ли пользоваться Readling бесплатно?</summary>
          <div class="faq-item__answer">
            Да, бесплатная версия даёт доступ к части каталога. Подписка открывает все книги, убирает рекламу
            и даёт доступ ко всем функциям. Первые 7 дней — бесплатно.
          </div>
        </details>
        <details class="faq-item">
          <summary>Какие книги есть в каталоге?</summary>
          <div class="faq-item__answer">
            Более 100 книг в 25 жанрах: детективы, фантастика, классика, романтика, научпоп и другие.
            Часть книг доступна в режиме параллельного чтения, часть — в режиме погружения. У каждой книги в каталоге указан её режим.
          </div>
        </details>
        <details class="faq-item">
          <summary>Как работают тренировки?</summary>
          <div class="faq-item__answer">
            Когда вы читаете и нажимаете на незнакомое слово, оно сохраняется в ваш личный словарь.
            Тренировки — флэш-карточки, пазлы предложений, вставка слов — помогают запомнить именно ваши слова,
            а не случайные из учебника.
          </div>
        </details>
        <details class="faq-item">
          <summary>На каких устройствах работает Readling?</summary>
          <div class="faq-item__answer">
            На iPhone и Android-смартфонах. Скачайте бесплатно из App Store или Google Play.
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- Schema.org -->
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Readling",
      "url": "https://readling.club/",
      "logo": "https://readling.club/logo.png",
      "description": "Мобильное приложение для изучения английского через чтение книг с режимом погружения и параллельным переводом.",
      "foundingDate": "2024",
      "sameAs": [
        "https://apps.apple.com/by/app/readling-%D0%B0%D0%BD%D0%B3%D0%BB%D0%B8%D0%B9%D1%81%D0%BA%D0%B8%D0%B9-%D0%BF%D0%BE-%D0%BA%D0%BD%D0%B8%D0%B3%D0%B0%D0%BC/id6752216664",
        "https://play.google.com/store/apps/details?id=com.karpukdm.readling",
        "https://t.me/readlingapp"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer support",
        "url": "https://t.me/readlingapp",
        "availableLanguage": ["Russian", "English"]
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
