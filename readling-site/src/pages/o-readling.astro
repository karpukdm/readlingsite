---
import BaseLayout from '../layouts/BaseLayout.astro';
import { links } from '../config/links';
import { getPageDates } from '../utils/dates';

const { datePublished, dateModified } = getPageDates('src/pages/o-readling.astro');
---

<BaseLayout
  title="О Readling — кто создал приложение для чтения книг на английском"
  description="Кто стоит за Readling, как и зачем мы делаем приложение для изучения английского через чтение книг. Контакты, миссия, команда."
  canonicalPath="/o-readling"
>
  <!-- BREADCRUMBS -->
  <nav class="breadcrumbs" aria-label="Хлебные крошки">
    <div class="container">
      <a href="/">Главная</a>
      <span class="breadcrumbs__sep">/</span>
      <span>О Readling</span>
    </div>
  </nav>

  <section class="section">
    <div class="container max-w-wide mx-auto">
      <h1 class="mb-m">О Readling — приложение, которое учит английскому через книги</h1>
      <p class="lead mb-xl">
        <strong>Readling — это мобильное приложение для iOS и Android, которое помогает русскоязычным
        читателям выучить английский через чтение настоящих книг.</strong>
        Мы делаем то, чего не делает ни одно другое приложение: даём вам читать живую литературу с первого дня,
        используя плавное погружение и параллельный перевод.
      </p>

      <h2 class="mb-m">Зачем мы создали Readling</h2>
      <p class="mb-m">
        Большинство приложений для изучения английского строятся вокруг упражнений: переводи предложения,
        выбирай ответы, повторяй слова. Это работает на старте, но через полгода прогресс останавливается.
        Слова забываются, мотивация тает, а до настоящего английского — книг, статей, фильмов в оригинале —
        так и не доходит.
      </p>
      <p class="mb-l">
        Мы хотели приложение, которое <strong>сразу даёт читать настоящие книги</strong> — детективы Конан Дойла,
        фантастику Уэллса, классику Остин — но не оставляет один на один с непонятным текстом.
        Так появился метод погружения: английский постепенно появляется внутри русского текста.
        К концу книги вы уже читаете на английском — и не помните момента, когда это произошло.
      </p>

      <h2 class="mb-m">Чем Readling отличается от других приложений</h2>
      <ul class="bullets mb-l">
        <li><strong>Настоящие книги, а не учебные тексты.</strong> 200+ произведений в 25 жанрах — от A1 до C2.</li>
        <li><strong>Метод плавного погружения.</strong> Английский постепенно замещает русский внутри страницы.</li>
        <li><strong>Параллельное чтение.</strong> Оригинал и перевод рядом — для разбора грамматики.</li>
        <li><strong>Тренировки на ваших словах.</strong> Не списки из учебника, а слова, которые встретились вам в книге.</li>
        <li><strong>Без рекламы и психологического давления.</strong> Никаких лиг, наказаний, всплывающих окон.</li>
      </ul>

      <h2 class="mb-m">Кто стоит за Readling</h2>
      <p class="mb-m">
        Readling создаёт независимая команда разработчиков и редакторов. Идея появилась из личного опыта
        изучения английского через чтение — когда стало ясно, что лучшие книги для практики недоступны
        начинающим из-за порога входа.
      </p>
      <p class="mb-l">
        Над приложением работают: разработчики (iOS, Android, backend), литературные редакторы
        (отбор книг и адаптация под уровни), переводчики (вычитка и сверка перевода).
        Мы не венчурный стартап и не корпорация — мы небольшая команда, которая делает продукт,
        потому что сами хотели бы им пользоваться.
      </p>

      <h2 class="mb-m">Контакты</h2>
      <p class="mb-s">
        Поддержка и обратная связь — в Telegram: <a href={links.support} target="_blank" rel="noopener">@readlingapp</a>.
      </p>
      <p class="mb-s">
        Сайт: <a href="https://readling.club/">readling.club</a>
      </p>
      <p class="mb-l">
        Приложение:
        <a href={links.appStore} target="_blank" rel="noopener">App Store</a> ·
        <a href={links.googlePlay} target="_blank" rel="noopener">Google Play</a>
      </p>

      <h2 class="mb-m">Юридическая информация</h2>
      <p>
        <a href={links.privacy} target="_blank" rel="noopener">Политика конфиденциальности</a> ·
        <a href={links.terms} target="_blank" rel="noopener">Условия использования</a>
      </p>
    </div>
  </section>

  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "name": "О Readling",
      "url": "https://readling.club/o-readling/",
      "inLanguage": "ru",
      "datePublished": datePublished,
      "dateModified": dateModified,
      "about": {
        "@type": "Organization",
        "name": "Readling",
        "url": "https://readling.club/",
        "logo": "https://readling.club/logo.png",
        "description": "Мобильное приложение для изучения английского через чтение книг с режимом погружения и параллельным переводом.",
        "foundingDate": "2024",
        "sameAs": [
          "https://apps.apple.com/by/app/readling-%D0%B0%D0%BD%D0%B3%D0%BB%D0%B8%D0%B9%D1%81%D0%BA%D0%B8%D0%B9-%D0%BF%D0%BE-%D0%BA%D0%BD%D0%B8%D0%B3%D0%B0%D0%BC/id6752216664",
          "https://play.google.com/store/apps/details?id=com.karpukdm.readling",
          "https://t.me/readlingapp"
        ]
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://readling.club/" },
        { "@type": "ListItem", "position": 2, "name": "О Readling", "item": "https://readling.club/o-readling/" }
      ]
    })} />
  </Fragment>
</BaseLayout>

<style>
  .breadcrumbs {
    padding: var(--space-m) 0;
    font-size: 0.875rem;
    color: var(--color-text-tertiary);
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-card-border);
  }
  .breadcrumbs a { color: var(--color-text-tertiary); }
  .breadcrumbs a:hover { color: var(--color-primary); }
  .breadcrumbs__sep { margin: 0 var(--space-xs); }

  .lead {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .lead strong {
    color: var(--color-text);
  }

  h2 {
    font-size: 1.5rem;
    margin-top: var(--space-xxl);
  }

  .bullets {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .bullets li {
    padding-left: var(--space-l);
    position: relative;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-primary);
  }

  .bullets strong {
    color: var(--color-text);
  }
</style>
