---
import BaseLayout from '../layouts/BaseLayout.astro';
import { links } from '../config/links';

const PAGE_URL = new URL('/download/', Astro.site).toString();
---

<BaseLayout
  title="Скачать Readling — App Store и Google Play"
  description="Скачайте Readling для iPhone, iPad или Android. Английский по книгам: 7 дней бесплатно, без рекламы."
  canonicalPath="/download/"
  noindex={true}
>
  {/* Короткая ссылка «скачать» для соцсетей, рассылок и QR: телефон сразу
      уходит в свой магазин, остальным (компьютер, неизвестное устройство)
      показываем обе кнопки. Скрипт стоит в <head>, чтобы редирект случился
      до отрисовки страницы и без мигания. iPadOS 13+ представляется
      «Macintosh», поэтому его отличаем от Mac по сенсорному экрану.
      Та же проверка стоит у кнопки «Скачать» в src/components/Header.astro.

      Встроенный браузер TikTok не пускает в магазины: на реальных iPhone
      и Android и автоматический редирект, и нажатие на ссылку магазина,
      и попытки открыть системный браузер (x-safari-https, intent://)
      заканчиваются «Не удалось выполнить действие». Работает только ручной
      выход через меню «⋯», поэтому в TikTok показываем инструкцию к нему
      и кнопку копирования ссылки. */}
  <script is:inline slot="head" define:vars={{ appStore: links.appStore, googlePlay: links.googlePlay }}>
    (function () {
      var ua = navigator.userAgent;
      var isIOS = /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
      var isAndroid = /Android/.test(ua);
      if (!isIOS && !isAndroid) return;
      if (!/musical_ly|trill_|Bytedance|TikTok/i.test(ua)) {
        location.replace(isIOS ? appStore : googlePlay);
        return;
      }
      document.documentElement.dataset.inapp = isIOS ? 'ios' : 'android';
    })();
  </script>

  <section class="section download">
    <div class="container text-center">
      <h1 class="mb-m">Скачать Readling</h1>
      <p class="download__text mb-l">
        Английский по книгам на iPhone, iPad и Android. 7 дней бесплатно, без рекламы.
      </p>

      <div class="store-buttons" style="justify-content: center;">
        <a href={links.appStore} class="store-btn"><img src="/badge-appstore.svg" alt="Загрузите в App Store" /></a>
        <a href={links.googlePlay} class="store-btn store-btn--google"><img src="/badge-google-play.png" alt="Доступно в Google Play" /></a>
      </div>

      <div class="download__escape">
        <p class="download__escape-title">
          TikTok не открывает <span class="download__ios">App Store</span><span class="download__android">Google Play</span>
        </p>
        <ol class="download__steps">
          <li>Нажмите <b>«⋯»</b> в правом верхнем углу</li>
          <li>Выберите <b>«Открыть в браузере»</b></li>
        </ol>
        <p class="download__escape-text">
          Страница откроется в <span class="download__ios">Safari</span><span class="download__android">браузере</span>
          и сама перенаправит в <span class="download__ios">App Store</span><span class="download__android">Google Play</span>.
        </p>
        <button type="button" class="btn btn--secondary download__copy" data-copy={PAGE_URL}>
          Или скопировать ссылку для браузера
        </button>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var button = document.querySelector('[data-copy]');
    if (!button) return;
    var label = button.textContent.trim();

    function fallbackCopy(text) {
      var input = document.createElement('textarea');
      input.value = text;
      input.setAttribute('readonly', '');
      input.style.position = 'fixed';
      input.style.opacity = '0';
      document.body.appendChild(input);
      input.select();
      input.setSelectionRange(0, text.length);
      var ok = false;
      try { ok = document.execCommand('copy'); } catch (e) {}
      document.body.removeChild(input);
      return ok;
    }

    function done(ok) {
      // Не удалось скопировать — показываем саму ссылку, её можно выделить вручную.
      button.textContent = ok ? 'Ссылка скопирована — вставьте её в браузер' : button.dataset.copy;
      setTimeout(function () { button.textContent = label; }, 4000);
    }

    button.addEventListener('click', function () {
      var url = button.dataset.copy;
      // Clipboard API во встроенных браузерах бывает отключён — тогда старый способ.
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(function () { done(true); }, function () { done(fallbackCopy(url)); });
      } else {
        done(fallbackCopy(url));
      }
    });
  })();
</script>

<style>
  .download {
    padding: var(--space-xxl) 0;
  }

  .download__text {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    max-width: 480px;
    margin: 0 auto var(--space-l);
  }

  /* В TikTok кнопки магазинов дают только ошибку — вместо них инструкция. */
  .download__escape,
  .download__escape .download__ios,
  .download__escape .download__android {
    display: none;
  }

  :global(html[data-inapp]) .store-buttons {
    display: none;
  }

  :global(html[data-inapp]) .download__escape {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    max-width: 360px;
    margin: 0 auto;
  }

  :global(html[data-inapp='ios']) .download__escape .download__ios,
  :global(html[data-inapp='android']) .download__escape .download__android {
    display: inline;
  }

  .download__escape-title {
    font-weight: 700;
    font-size: 1.0625rem;
  }

  .download__escape-text {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-s);
  }

  .download__steps {
    margin: var(--space-s) 0;
    padding: var(--space-m) var(--space-m) var(--space-m) calc(var(--space-m) + 1.25em);
    text-align: left;
    font-size: 1.0625rem;
    line-height: 1.6;
    background: var(--color-surface);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-md);
  }

  .download__copy {
    width: 100%;
    white-space: normal;
  }
</style>
