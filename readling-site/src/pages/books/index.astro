---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { genreLabels, coverPath, coverSrcset, plural } from '../../utils/slug';
import { catalog, indexableCatalog, appCatalog, type CatalogBook } from '../../utils/catalog';

const books = catalog;

// Group books by primary genre categories (order matters for display)
const genreOrder = [
  'CHILDRENS',
  'CLASSIC',
  'ADVENTURE',
  'MYSTERY',
  'SCIENCE_FICTION',
  'FANTASY',
  'HORROR',
  'ROMANCE',
  'DRAMA',
  'PHILOSOPHY',
  'BIOGRAPHY',
  'NON_FICTION',
  'SELF_HELP',
  'HISTORICAL',
  'POETRY',
];

// Assign each book to one primary genre (first matching from genreOrder)
const genreGroups = new Map<string, CatalogBook[]>();
const assigned = new Set<string>();

for (const genre of genreOrder) {
  const genreBooks = books.filter(b => !assigned.has(b.slug) && b.genres.includes(genre));
  if (genreBooks.length > 0) {
    genreGroups.set(genre, genreBooks);
    genreBooks.forEach(b => assigned.add(b.slug));
  }
}
---

<BaseLayout
  title="Книги на английском с переводом — каталог Readling"
  description={`${books.length} книг на английском с русским переводом: классика, детективы, фантастика, романтика — от A1 до C2. Первые 7 дней бесплатно.`}
  canonicalPath="/books"
>
  <!-- BREADCRUMBS -->
  <nav class="breadcrumbs" aria-label="Хлебные крошки">
    <div class="container">
      <a href="/">Главная</a>
      <span class="breadcrumbs__sep">/</span>
      <span>Книги</span>
    </div>
  </nav>

  <section class="section">
    <div class="container">
      <h1 class="text-center mb-sm">Книги на английском с переводом — каталог Readling</h1>
      {/* Число берём из каталога, а не пишем «более 100»: на странице должно быть
          столько книг, сколько заявлено, иначе обещание не совпадает с содержимым. */}
      <p class="text-center max-w-prose mx-auto mb-xl">
        <strong>В каталоге на сайте — {books.length} {plural(books.length, 'книга', 'книги', 'книг')} на английском с русским переводом,
        по уровням от A1 до C2.</strong>
        Каждая книга доступна в режиме параллельного чтения или плавного погружения —
        выбирайте подход, который вам подходит.
      </p>

      {Array.from(genreGroups.entries()).map(([genre, genreBooks]) => (
        <div class="genre-section">
          <h2 class="genre-section__title">{genreLabels[genre] || genre}</h2>
          <div class="books-grid">
            {genreBooks.map(book => (
              <a href={`/books/${book.slug}/`} class="book-item">
                <img
                  class="book-item__cover"
                  src={coverPath(book.title, 'sm')}
                  srcset={coverSrcset(book.title, 'card')}
                  alt={`Обложка «${book.displayTitle}» — ${book.displayAuthor}, ${(genreLabels[genre] || genre).toLowerCase()}, уровень ${book.level}`}
                  loading="lazy"
                  decoding="async"
                  width="160"
                  height="240"
                />
                <div class="book-item__info">
                  <span class="book-item__level">{book.level}</span>
                  <div class="book-item__title">{book.displayTitle}<span class="visually-hidden"> на английском с переводом</span></div>
                  <div class="book-item__author">{book.displayAuthor}</div>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}

      <div class="more-books">
        <div class="more-books__inner">
          <h3 class="mb-s">Ещё больше книг — в приложении</h3>
          <p>
            Здесь показана часть каталога. В приложении Readling — {appCatalog.books} книг на английском
            с переводом в {appCatalog.genres} жанрах. Новые книги добавляются каждую неделю.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Книги на английском с переводом — каталог Readling",
      "description": `${indexableCatalog.length} книг на английском с русским переводом для изучения языка.`,
      "url": "https://readling.club/books/",
      "inLanguage": "ru",
      "isPartOf": {
        "@type": "WebSite",
        "name": "Readling",
        "url": "https://readling.club/"
      },
      // В ItemList перечисляем только индексируемые книги: ссылаться схемой на
      // noindex-страницы — противоречивый сигнал.
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": indexableCatalog.length,
        "itemListElement": indexableCatalog.slice(0, 30).map((b, i) => ({
          "@type": "ListItem",
          "position": i + 1,
          "url": `https://readling.club/books/${b.slug}/`,
          "name": b.displayTitle,
        }))
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://readling.club/" },
        { "@type": "ListItem", "position": 2, "name": "Книги", "item": "https://readling.club/books/" },
      ]
    })} />
  </Fragment>
</BaseLayout>

<style>
  .breadcrumbs {
    padding: var(--space-m) 0;
    font-size: 0.875rem;
    color: var(--color-text-tertiary);
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-card-border);
  }
  .breadcrumbs a { color: var(--color-text-tertiary); }
  .breadcrumbs a:hover { color: var(--color-primary); }
  .breadcrumbs__sep { margin: 0 var(--space-xs); }

  .genre-section {
    margin-bottom: var(--space-xxl);
  }

  .genre-section__title {
    margin-bottom: var(--space-m);
    padding-bottom: var(--space-xs);
    border-bottom: 2px solid var(--color-primary);
    display: inline-block;
  }

  .books-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: var(--space-l);
  }

  .book-item {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .book-item:hover {
    transform: translateY(-4px);
    color: inherit;
  }

  .book-item__cover {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-card-border);
    background: var(--color-surface-alt);
    margin-bottom: var(--space-s);
  }

  .book-item__info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .book-item__level {
    display: inline-block;
    width: fit-content;
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-size: 0.6875rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    margin-bottom: var(--space-xs);
  }

  .book-item__title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.3;
  }

  .book-item__author {
    font-size: 0.75rem;
    color: var(--color-text-tertiary);
  }

  .more-books {
    margin-top: var(--space-l);
    border-top: 1px solid var(--color-card-border);
    padding-top: var(--space-xl);
  }

  .more-books__inner {
    text-align: center;
    max-width: 560px;
    margin: 0 auto;
  }

  @media (max-width: 480px) {
    .books-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-m);
    }
  }
</style>
