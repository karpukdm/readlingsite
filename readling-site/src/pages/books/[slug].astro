---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { links } from '../../config/links';
import {
  complexityToLevel,
  genreLabels,
  genreDescriptions,
  levelDescriptions,
  extractSnippet,
  plural,
  coverPath,
  coverSrcset,
} from '../../utils/slug';
import { catalog, booksBySameAuthor, lexiconMedians, type CatalogBook, type ExcerptSentence } from '../../utils/catalog';

export function getStaticPaths() {
  return catalog.map(book => ({
    params: { slug: book.slug },
    props: { book },
  }));
}

const { book } = Astro.props as { book: CatalogBook };
const { slug, level, complexity, genres, immersion, parallel, stat, russianTitle } = book;
const levelInfo = levelDescriptions[level.toLowerCase()];

// В текстах страницы книга называется по-русски (`displayTitle`) — так её ищут.
// `book.title` — название канонической записи, оно нужно для имён файлов обложек:
// у объединённых пар это английский оригинал.
const name = book.displayTitle;
const author = book.displayAuthor;
/**
 * Полное название канонической записи — показываем под H1, когда оно отличается
 * от отображаемого: либо это английский оригинал русского названия, либо полное
 * название с подзаголовком, который в H1 обрезан.
 */
const originalTitle = book.title !== book.displayTitle ? book.title : null;

// Режимы чтения: у объединённых записей книга доступна и в погружении, и
// в параллельном чтении, поэтому показываем оба отрывка — см. utils/catalog.ts.
const hasImmersionMode = book.modes.includes('immersion');
const hasParallelMode = book.modes.includes('parallel');
const bothModes = hasImmersionMode && hasParallelMode;
const modeLabel = bothModes
  ? 'Погружение и параллельное чтение'
  : hasParallelMode
    ? 'Параллельное чтение'
    : 'Режим погружения';
// «Параллельный перевод» в заголовках — только когда это единственный режим.
const isParallel = hasParallelMode && !hasImmersionMode;

// Доля английского для показа режима погружения — как ранняя ступень в приложении.
const IMMERSION_SHARE = 0.25;
const wordCount = (s: string) => s.split(/\s+/).filter(Boolean).length;

// Плетение одного предложения: простые фразы (низкий complexity) переходят на английский
// первыми, пока доля английских слов не достигнет IMMERSION_SHARE — тот же принцип, что в приложении.
function weaveSentence(sent: ExcerptSentence) {
  const ph = sent.phrases;
  const tail = (sent.ru.match(/[.!?…»)]+$/) || [''])[0];
  if (!ph || ph.length === 0) return { tokens: [{ t: sent.ru, en: false }], tail: '' };
  const total = ph.reduce((n, p) => n + wordCount(p.ru), 0) || 1;
  const order = ph.map((p, i) => ({ i, cx: p.cx })).sort((a, b) => a.cx - b.cx || a.i - b.i);
  const enSet = new Set<number>();
  let enW = 0;
  for (const { i } of order) {
    if (enW / total >= IMMERSION_SHARE) break;
    enSet.add(i);
    enW += wordCount(ph[i].ru);
  }
  const tokens = ph.map((p, i) => {
    if (!enSet.has(i)) return { t: p.ru, en: false, ru: '' };
    let t = p.en;
    // не-первую английскую фразу пишем со строчной, если русский аналог строчный
    // (так имена собственные — «Winston Smith» — остаются с заглавной)
    if (i > 0 && /^[а-яё]/.test(p.ru)) t = t.charAt(0).toLowerCase() + t.slice(1);
    return { t, en: true, ru: p.ru };
  });
  return { tokens, tail };
}

const immersionData = immersion ? immersion.sentences.map(weaveSentence) : [];

const primaryGenreCode = genres[0];
const primaryGenreLabel = genreLabels[primaryGenreCode] || primaryGenreCode;
const primaryGenreInfo = genreDescriptions[primaryGenreCode];

// Похожие книги: по жанру + уровню
const otherBooks = catalog.filter(b => b.slug !== slug);
const bookGenres = new Set(genres);
const scored = otherBooks
  .map(b => {
    let score = 0;
    if (b.genres.some(g => bookGenres.has(g))) score += 2;
    if (b.complexity === complexity) score += 1;
    if (Math.abs(b.complexity - complexity) === 1) score += 0.5;
    return { book: b, score };
  })
  .filter(s => s.score > 0)
  .sort((a, b) => b.score - a.score);
const relatedBooks = scored.slice(0, 6).map(s => s.book);

// Книги того же автора
const sameAuthorBooks = booksBySameAuthor(book);

const pagesPhrase = stat?.pages ? `${stat.pages} ${plural(stat.pages, 'страница', 'страницы', 'страниц')}` : '';

// Блок «Зачем читать» — мотивирующий: жанровый крючок + посильная цель + что получишь.
const modeReassurance = bothModes
  ? 'можно взять параллельный режим с переводом рядом или плавное погружение — и переключаться по ходу'
  : isParallel
    ? 'русский перевод всегда рядом — вы не застрянете на трудной фразе и не бросите на середине'
    : 'английский входит в текст постепенно, и вы втягиваетесь незаметно — без барьера «слишком сложно»';
const whyHook = `${primaryGenreInfo?.appeal || 'Прочитать любимую историю в оригинале — отдельное удовольствие, которого не даёт перевод.'} И «${name}» ${author ? `(${author}) ` : ''}на английском — это посильная цель:${pagesPhrase ? ` ${pagesPhrase}` : ''} на уровне ${level} (${levelInfo?.short || ''}), где ${modeReassurance}.`;
const whyPayoff = primaryGenreInfo?.vocab
  ? `А дочитав «${name}» до конца, вы не просто закроете книгу в оригинале — попутно освоите характерную лексику жанра (${primaryGenreInfo.vocab}), причём не зубрёжкой, а вместе с сюжетом.`
  : `А дочитав «${name}» до конца, вы закроете настоящую книгу в оригинале — и почувствуете язык совсем иначе, чем на учебных текстах.`;

/**
 * Лексический портрет книги — числа, посчитанные по её полному тексту.
 * Голое «уровень B2» есть на десятке сайтов; замеры — только у нас, и они
 * объясняют, почему уровень именно такой.
 */
const lex = book.lexicon;

const numberFmt = new Intl.NumberFormat('ru-RU');

// Сравнение с медианой каталога: «11,6% редкой лексики» само по себе пусто,
// а «заметно выше, чем в остальных книгах» — уже факт.
const rare2000 = lex?.rare['2000'] ?? 0;
const rareVerdict = !lex
  ? ''
  : rare2000 > lexiconMedians.rare2000 * 1.15
    ? 'заметно выше среднего: словарь книги богатый, готовьтесь встречать незнакомое'
    : rare2000 < lexiconMedians.rare2000 * 0.85
      ? 'ниже среднего: книга держится частотной лексики, незнакомых слов немного'
      : 'на уровне среднего по каталогу';

/**
 * Доля простых фраз (сложность 1–2) — из оценки, которую приложение ставит
 * каждой фразе при выравнивании. Именно с них начинается режим погружения,
 * поэтому число отвечает на вопрос «а мне будет посильно».
 */
const easyPhraseShare = lex
  ? Math.round((lex.cx['1'] ?? 0) + (lex.cx['2'] ?? 0))
  : 0;

// Время чтения: 150 слов в минуту — темп чтения на неродном языке; на родном
// он около 240, и брать его для оценки английского текста было бы враньём.
const READING_WPM = 150;
const readingHours = lex ? Math.round(lex.words / READING_WPM / 60) : 0;

// Title и description держим в пределах, которые Google показывает целиком
// (~60 и ~160 символов). Ключевая фраза идёт первой, поэтому обрезка у длинных
// названий книг не съедает главное.
// Бренд в конце — приятный бонус, но у длинных названий он вылезает за границу
// показа и обрезается вместе с уровнем. Поэтому у длинных названий его убираем:
// лучше показать «...с переводом — B2» целиком, чем оборванное «| Readl…».
const titleCore = `${name} на английском с переводом — ${level}`;
const pageTitle = titleCore.length + ' | Readling'.length <= 60
  ? `${titleCore} | Readling`
  : titleCore;

// В meta description английский синопсис из БД не пускаем: страница русская, и
// сниппет на английском не совпадает ни с запросом, ни с языком страницы.
// Пока у книги нет русского описания, собираем сниппет из того, что достоверно:
// автор, жанр, уровень и режимы чтения.
// Короткий синопсис из БД — это готовая фраза на одно предложение, и в сниппете
// она читается лучше, чем обрезанный по длине абзац полного описания.
const DESCRIPTION_SUFFIX = ` Читайте на английском с русским переводом в Readling, уровень ${level}.`;
const descriptionSource = book.shortDescription
  ?? (book.descriptionLang === 'ru'
    ? book.description
    : `«${name}» — ${author}, ${primaryGenreLabel.toLowerCase()}${pagesPhrase ? `, ${pagesPhrase}` : ''}.`);
const pageDescription =
  extractSnippet(descriptionSource, 160 - DESCRIPTION_SUFFIX.length) + DESCRIPTION_SUFFIX;

// H1 и лид-абзац под ключевые запросы («[книга] на английском с [параллельным] переводом»).
// У объединённых пар в H1 идут оба названия: русское — то, что ищут, английское —
// то, что читатель увидит на обложке в приложении.
const translationPhrase = isParallel ? 'с параллельным переводом' : 'с переводом';
const pageH1 = `${name} на английском ${translationPhrase}`;
const heroLead = bothModes
  ? `«${name}»${originalTitle ? ` (${originalTitle})` : ''} — ${author}. Читать на английском с русским переводом онлайн: параллельный режим с переводом рядом или плавное погружение. ${primaryGenreLabel}, уровень ${level}.`
  : isParallel
    ? `«${name}»${originalTitle ? ` (${originalTitle})` : ''} — ${author}. Читать на английском с параллельным русским переводом онлайн: английский оригинал и перевод рядом. ${primaryGenreLabel}, уровень ${level}.`
    : `«${name}» (${author}) — читать на английском с русским переводом онлайн в режиме погружения. ${primaryGenreLabel}, уровень ${level}.`;

// Тексты для FAQ (вычисляем в frontmatter, чтобы не использовать `<=` в JSX)
const previousLevel = complexityToLevel[Math.max(1, complexity - 1)];
const faqLevelAnswer = hasParallelMode
  ? `В параллельном режиме рядом с английским всегда идёт русский перевод — это страховка для тех, кто пока не уверен в уровне ${level}.`
  : complexity <= 2
    ? `В режиме погружения текст начинается почти полностью на русском, поэтому «${name}» комфортна даже на уровне A1.`
    : `В режиме погружения сложность нарастает плавно — поэтому «${name}» доступна и читателям уровня ${previousLevel}, готовым к небольшому вызову.`;

// FAQ рендерится и в разметку, и в JSON-LD из одного массива: структурированные
// данные обязаны дословно совпадать с видимым текстом, иначе Google считает их
// недостоверными и игнорирует всю схему страницы.
//
// Раньше здесь лежали три вопроса одной формы с подставленным названием книги, и
// на 88 страницах это давало самый заметный шаблонный блок на сайте. Теперь три
// вопроса общие для всех книг, а остальные подбираются по самой книге — по её
// замерам, году и объёму, — поэтому наборы у разных книг не совпадают.
const vocabSample = lex?.vocabulary.slice(0, 3).map(w => `${w.w} — ${w.ru}`).join(', ');

const coreFaq = [
  {
    q: `Какой уровень английского нужен для «${name}»?`,
    a: `«${name}» рассчитана на уровень ${level} (${levelInfo?.short || ''}). ${faqLevelAnswer}`,
  },
  {
    q: `Какую лексику я выучу, читая «${name}»?`,
    a: lex && vocabSample
      ? `Мы разобрали полный текст: ${rare2000}% слов книги лежат вне двух тысяч самых частотных в английском. Характерные для неё слова — ${vocabSample}. Каждое слово, на которое вы нажмёте при чтении, попадёт в личный словарь, а оттуда — в тренировки: флэш-карточки, пазлы предложений, вставка слов.`
      : `«${name}» относится к жанру «${primaryGenreLabel.toLowerCase()}». ${primaryGenreInfo?.vocab ? `Это значит — ${primaryGenreInfo.vocab}.` : 'Это значит — характерная для жанра лексика.'} Каждое слово, на которое вы нажмёте при чтении, попадёт в личный словарь. Дальше — тренировки именно на эту лексику: флэш-карточки, пазлы предложений, вставка слов.`,
  },
  {
    q: `Можно ли читать «${name}» бесплатно?`,
    a: `В Readling действует пробный период 7 дней — вы получаете доступ ко всем книгам каталога, включая «${name}», ко всем режимам чтения и тренировкам. После пробного периода никаких автосписаний — продолжать подписку или нет, решаете вы.`,
  },
];

/**
 * Вопросы, которые есть смысл задавать не о каждой книге: они опираются на её
 * замеры, возраст или объём. Из подходящих берём два — какие именно, зависит от
 * слуга, поэтому соседние книги в каталоге получают разные пары.
 */
const optionalFaq = [
  lex && {
    q: `Сколько времени займёт прочитать «${name}» на английском?`,
    a: `В книге ${numberFmt.format(lex.words)} ${plural(lex.words, 'слово', 'слова', 'слов')}. При темпе около ${READING_WPM} слов в минуту — обычный темп чтения на неродном языке — это примерно ${readingHours} ${plural(readingHours, 'час', 'часа', 'часов')} чистого чтения. По 20 минут в день книга займёт около ${Math.max(1, Math.round((readingHours * 60) / 20 / 7))} ${plural(Math.max(1, Math.round((readingHours * 60) / 20 / 7)), 'недели', 'недель', 'недель')}.`,
  },
  lex && {
    q: `Сложный ли язык в «${name}»?`,
    a: `Доля редкой лексики — ${rare2000}% слов вне двух тысяч самых частотных в английском, ${rareVerdict}. При этом ${easyPhraseShare}% фраз книги простые: с них и начинается режим погружения.`,
  },
  book.year && book.year < 1900 && {
    q: `Не устарел ли английский в «${name}»?`,
    a: `Книга написана в ${book.year} году, и отдельные обороты в ней действительно устаревшие. На понимание это не влияет: основа языка с тех пор не изменилась, а редкие архаизмы переводятся по нажатию, как и любое другое слово. Читать классику в оригинале — обычная практика, и именно на ней строятся школьные и университетские курсы английского.`,
  },
  stat?.pages && {
    q: `Большая ли книга «${name}»?`,
    a: `В «${name}» ${pagesPhrase}${stat.chapters ? ` и ${stat.chapters} ${plural(stat.chapters, 'глава', 'главы', 'глав')}` : ''}. Читать её целиком за раз не нужно: Readling запоминает место, где вы остановились, и показывает прогресс по главам.`,
  },
  relatedBooks.length > 0 && {
    q: `Что почитать после «${name}»?`,
    a: `Ближе всего по уровню и теме — «${relatedBooks[0].displayTitle}»${relatedBooks[1] ? ` и «${relatedBooks[1].displayTitle}»` : ''}. Полная подборка похожих книг — выше на этой странице, а все книги уровня ${level} собраны на отдельной странице каталога.`,
  },
].filter(Boolean) as Array<{ q: string; a: string }>;

// Смещение по слугу — не случайность: сборка должна быть воспроизводимой, иначе
// FAQ менялся бы при каждом деплое и страницы получали бы новый lastmod.
const faqOffset = [...slug].reduce((sum, ch) => sum + ch.charCodeAt(0), 0);
const EXTRA_FAQ = 2;
const rotatedOptional = optionalFaq.length
  ? Array.from({ length: Math.min(EXTRA_FAQ, optionalFaq.length) },
      (_, i) => optionalFaq[(faqOffset + i) % optionalFaq.length])
  : [];

const faqItems = [...coreFaq, ...rotatedOptional];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={`/books/${slug}`}
  ogImage={`/og-books/${slug}.png`}
  ogType="book"
  noindex={book.noindex}
>
  <!-- BREADCRUMBS -->
  <nav class="breadcrumbs" aria-label="Хлебные крошки">
    <div class="container">
      <a href="/">Главная</a>
      <span class="breadcrumbs__sep">/</span>
      <a href="/books/">Книги</a>
      <span class="breadcrumbs__sep">/</span>
      <span>{name}</span>
    </div>
  </nav>

  <!-- HERO -->
  <section class="book-hero">
    <div class="container">
      <div class="book-hero__inner">
        <div class="book-hero__cover">
          <img src={coverPath(book.title, 'md')} srcset={coverSrcset(book.title, 'hero')} alt={`Обложка книги «${name}» — ${author}, ${primaryGenreLabel.toLowerCase()}, уровень ${level}`} width="240" height="360" fetchpriority="high" decoding="async" />
        </div>
        <div class="book-hero__info">
          <h1 class="mb-s">{pageH1}</h1>
          {originalTitle && (
            <p class="book-hero__original" lang="en">{originalTitle}</p>
          )}
          <p class="book-hero__author mb-m">{author}</p>
          <div class="book-hero__tags mb-m">
            <span class="tag tag--level">{level}</span>
            <span class="tag tag--mode">{modeLabel}</span>
            {genres.map((g: string) => (
              <span class="tag">{genreLabels[g] || g}</span>
            ))}
          </div>
          <p class="book-hero__lead mb-m">{heroLead}</p>
          {/* У части книг синопсис в БД пока только английский — помечаем его
              языком, чтобы страница не заявляла русский текст там, где его нет. */}
          <p class="book-hero__desc mb-m" lang={book.descriptionLang}>{book.description}</p>
          <div class="store-buttons">
            <a href={links.appStore} target="_blank" rel="noopener" class="store-btn"><img src="/badge-appstore.svg" alt="Загрузите в App Store" /></a>
            <a href={links.googlePlay} target="_blank" rel="noopener" class="store-btn store-btn--google"><img src="/badge-google-play.png" alt="Доступно в Google Play" /></a>
          </div>
        </div>
      </div>
      {/* Колонок ровно столько, сколько фактов: у книг без года их четыре, с годом —
          пять. Фиксированное `repeat(4, 1fr)` переносило бы пятый факт на вторую
          строку, и разделители слева вставали бы в начало строки. */}
      <div class="facts-strip" style={`--fact-count: ${book.year ? 5 : 4}`}>
        <div class="fact"><span class="fact__label">Автор</span><span class="fact__value">{author}</span></div>
        {book.year && (
          <div class="fact"><span class="fact__label">Год издания</span><span class="fact__value">{book.year}</span></div>
        )}
        <div class="fact"><span class="fact__label">Уровень</span><span class="fact__value">{level} · {levelInfo?.short || ''}</span></div>
        <div class="fact"><span class="fact__label">Жанр</span><span class="fact__value">{primaryGenreLabel}</span></div>
        <div class="fact"><span class="fact__label">Режим чтения</span><span class="fact__value">{modeLabel}</span></div>
      </div>
    </div>
  </section>

  <!-- EXCERPT (реальные отрывки книги — по одному на каждый доступный режим) -->
  {(immersion || parallel) && (
    <section class="section excerpt-section" aria-labelledby="excerpt-title">
      <div class="container mx-auto">
        <h2 id="excerpt-title" class="text-center mb-sm">
          Отрывок «{name}» — {immersion && parallel
            ? 'два режима чтения'
            : parallel ? 'параллельное чтение' : 'режим погружения'}
        </h2>
        <p class="text-center max-w-prose mx-auto mb-l">
          {immersion && parallel
            ? 'Первая страница книги в каждом из режимов Readling — сравните и выберите, как читать «' + name + '».'
            : parallel
              ? 'Первая страница книги в параллельном режиме: английский оригинал и русский перевод рядом — так это выглядит в приложении Readling.'
              : 'Первая страница книги в режиме погружения: английский вплетён в русский текст. Здесь около 25% английского — в приложении его доля растёт с каждой главой.'}
        </p>

        {immersion && (
          <div class:list={['excerpt-mode', { 'excerpt-mode--paired': immersion && parallel }]}>
            {parallel && (
              <h3 class="excerpt-mode__title">Режим погружения</h3>
            )}
            {parallel && (
              <p class="excerpt-mode__hint">
                Английский вплетён в русский текст. Здесь около 25% английского — в приложении его
                доля растёт с каждой главой.
              </p>
            )}
            <div class="reader reader--immersion">
              <div class="reader__head">
                <span class="reader__dot" aria-hidden="true"></span>
                <span class="reader__dot" aria-hidden="true"></span>
                <span class="reader__dot" aria-hidden="true"></span>
                <span class="reader__mode">Режим погружения</span>
                <span class="reader__level">{level}</span>
              </div>
              <div class="reader__page">
                <p class="reader__text" lang="ru">
                  {immersionData.map(({ tokens, tail }) => (
                    <Fragment>
                      {tokens.map((tok, idx) => (
                        <Fragment>
                          {idx > 0 ? ' ' : ''}
                          {tok.en
                            ? <button type="button" class="ph" lang="en" data-ru={tok.ru} aria-label={`${tok.t} — перевод: ${tok.ru}`}>{tok.t}</button>
                            : tok.t}
                        </Fragment>
                      ))}
                      {tail}{' '}
                    </Fragment>
                  ))}
                </p>
                <p class="reader__tip">Нажмите на <span class="ph ph--demo">английскую фразу</span>, чтобы увидеть перевод</p>
              </div>
            </div>
          </div>
        )}

        {parallel && (
          <div class:list={['excerpt-mode', { 'excerpt-mode--paired': immersion && parallel }]}>
            {immersion && (
              <h3 class="excerpt-mode__title">Параллельное чтение</h3>
            )}
            {immersion && (
              <p class="excerpt-mode__hint">
                Английский оригинал и русский перевод строка в строку — удобно разбирать грамматику
                и не терять нить сюжета.
              </p>
            )}
            <div class="reader reader--parallel">
              <div class="reader__head">
                <span class="reader__dot" aria-hidden="true"></span>
                <span class="reader__dot" aria-hidden="true"></span>
                <span class="reader__dot" aria-hidden="true"></span>
                <span class="reader__mode">Параллельный режим</span>
                <span class="reader__level">{level}</span>
              </div>
              <div class="reader__cols">
                <div class="reader__colhead" aria-hidden="true">
                  <span>English</span>
                  <span>Русский</span>
                </div>
                {parallel.sentences.map((s: ExcerptSentence) => (
                  <div class="prow">
                    <p class="prow__en" lang="en">{s.en}</p>
                    <p class="prow__ru" lang="ru">{s.ru}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}

        {/* Кнопки магазинов на странице выводятся ещё дважды — в шапке и в
            финальном CTA. Третий повтор ничего не добавлял читателю, зато
            целиком уходил в текст, дословно совпадающий на всех страницах книг. */}
        <p class="excerpt__note text-center">
          Это начало «{name}». Полный текст с переводом по нажатию на любое слово, личным словарём
          и тренировками — в приложении Readling.
        </p>
      </div>

      {/* Тултип перевода для режима погружения */}
      <div id="ph-tooltip" class="ph-tooltip" role="tooltip" hidden></div>
      <script is:inline>
        (() => {
          const tip = document.getElementById('ph-tooltip');
          if (!tip) return;
          let open = null;
          const hide = () => { tip.hidden = true; open = null; };
          const show = (el) => {
            const ru = el.getAttribute('data-ru');
            if (!ru) return;
            tip.textContent = ru;
            tip.hidden = false;
            const r = el.getBoundingClientRect();
            const tr = tip.getBoundingClientRect();
            let left = r.left + window.scrollX + r.width / 2 - tr.width / 2;
            left = Math.max(8 + window.scrollX, Math.min(left, window.scrollX + document.documentElement.clientWidth - tr.width - 8));
            tip.style.left = left + 'px';
            tip.style.top = (r.top + window.scrollY - tr.height - 8) + 'px';
            open = el;
          };
          document.addEventListener('click', (e) => {
            const el = e.target.closest('.reader__text .ph');
            if (el) {
              e.preventDefault();
              if (open === el) { hide(); } else { show(el); }
            } else if (!e.target.closest('#ph-tooltip')) {
              hide();
            }
          });
          window.addEventListener('scroll', hide, { passive: true });
          window.addEventListener('resize', hide);
        })();
      </script>
    </section>
  )}

  <!-- BODY -->
  <section class="section">
    <div class="container">
      <div class="book-body">
        <div class="book-body__main">
          <h2 class="mb-m">Зачем читать «{name}» на английском</h2>
          <p class="mb-m">{whyHook}</p>
          <p class="mb-l">{whyPayoff}</p>

          <p class="book-body__more">
            Подробнее о режимах чтения: <a href="/parallelnoe-chtenie/">параллельное чтение</a> и <a href="/metod-pogruzheniya/">метод погружения</a>.
          </p>
        </div>

        {sameAuthorBooks.length > 0 && (
          <aside class="book-body__sidebar">
            <div class="side-card">
              <div class="side-card__title side-card__title--sm">Другие книги {author}</div>
              <ul class="author-list">
                {sameAuthorBooks.map(ab => (
                  <li>
                    <a href={`/books/${ab.slug}/`}>
                      {/* Путь к обложке строится по названию канонической записи
                          (у объединённых пар — английскому): это имя файла, а не
                          текст для читателя. Видимое название — русское. */}
                      <img src={coverPath(ab.title, 'sm')} alt={ab.displayTitle} loading="lazy" decoding="async" width="40" height="60" />
                      <div class="author-list__meta">
                        <span class="author-list__title">{ab.displayTitle}<span class="visually-hidden"> на английском с переводом</span></span>
                        <span class="author-list__level">{ab.level}</span>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        )}
      </div>
    </div>
  </section>

  <!-- ЯЗЫК КНИГИ: замеры по полному тексту -->
  {lex && (
    <section class="section section--alt" aria-labelledby="lexicon-title">
      <div class="container">
        <h2 id="lexicon-title" class="text-center mb-sm">Язык «{name}» в цифрах</h2>
        <p class="text-center max-w-prose mx-auto mb-l">
          Уровень {level} у этой книги не проставлен на глаз: мы разобрали её полный текст —
          {' '}{numberFmt.format(lex.words)} {plural(lex.words, 'слово', 'слова', 'слов')},
          {' '}{numberFmt.format(lex.sentences)} {plural(lex.sentences, 'предложение', 'предложения', 'предложений')} —
          и посчитали, из чего он состоит.
        </p>

        <div class="lex-stats max-w-wide mx-auto mb-l">
          <div class="lex-stat">
            <span class="lex-stat__value">{numberFmt.format(lex.words)}</span>
            <span class="lex-stat__label">слов в книге</span>
            <span class="lex-stat__note">около {readingHours} ч чтения</span>
          </div>
          <div class="lex-stat">
            <span class="lex-stat__value">{numberFmt.format(lex.distinctWords)}</span>
            <span class="lex-stat__label">уникальных словоформ</span>
            <span class="lex-stat__note">весь словарь книги</span>
          </div>
          <div class="lex-stat">
            <span class="lex-stat__value">{rare2000}%</span>
            <span class="lex-stat__label">редкой лексики</span>
            <span class="lex-stat__note">слов вне 2000 самых частотных</span>
          </div>
        </div>

        <div class="lex-read max-w-prose mx-auto mb-xl">
          <p class="mb-s">
            <strong>Лексика:</strong> {rare2000}% слов лежат за пределами двух тысяч самых
            частотных в английском — {rareVerdict}.
          </p>
          <p>
            <strong>Простых фраз:</strong> {easyPhraseShare}%. В режиме погружения они переходят
            на английский первыми.
          </p>
        </div>

      </div>
    </section>
  )}

  <!-- RELATED -->
  {relatedBooks.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <h2 class="text-center mb-sm">Похожие книги уровня {level}</h2>
        <p class="text-center max-w-prose mx-auto mb-xl">
          Если вам нравится «{name}», обратите внимание на эти книги в жанре {primaryGenreLabel.toLowerCase()} — они подобраны по уровню сложности и теме.
        </p>
        <div class="related-grid">
          {relatedBooks.map(rb => (
            <a href={`/books/${rb.slug}/`} class="related-book">
              <img class="related-book__cover" src={coverPath(rb.title, 'sm')} srcset={coverSrcset(rb.title, 'card')} alt={`Обложка «${rb.displayTitle}»`} loading="lazy" decoding="async" width="160" height="240" />
              <div class="related-book__info">
                <span class="related-book__level">{rb.level}</span>
                <div class="related-book__title">{rb.displayTitle}<span class="visually-hidden"> на английском с переводом</span></div>
                <div class="related-book__author">{rb.displayAuthor}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="section">
    <div class="container max-w-wide mx-auto">
      <h2 class="text-center mb-l">Вопросы о чтении «{name}» на английском</h2>
      <div class="faq-list">
        {faqItems.map(item => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <div class="faq-item__answer">{item.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-final">
    <div class="container">
      <div class="cta-final__card">
        <div>
          <div class="cta-final__title">Начните читать «{name}» прямо сейчас</div>
          <div class="cta-final__subtitle">Первые 7 дней — бесплатно. Без автосписаний.</div>
        </div>
        <div class="store-buttons">
          <a href={links.appStore} target="_blank" rel="noopener" class="store-btn"><img src="/badge-appstore.svg" alt="Загрузите в App Store" /></a>
          <a href={links.googlePlay} target="_blank" rel="noopener" class="store-btn store-btn--google"><img src="/badge-google-play.png" alt="Доступно в Google Play" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Schema.org -->
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Book",
      "name": name,
      // Английский оригинал названия — второе имя той же сущности, а не отдельная книга.
      ...(originalTitle ? { "alternateName": originalTitle } : {}),
      "author": {
        "@type": "Person",
        "name": author,
        ...(book.authors.length > 1 ? { "alternateName": book.authors.filter(a => a !== author) } : {}),
      },
      "description": book.description,
      "image": `https://readling.club${coverPath(book.title, 'lg')}`,
      "url": `https://readling.club/books/${slug}/`,
      "genre": genres.map((g: string) => genreLabels[g] || g),
      "inLanguage": ["en", "ru"],
      "bookFormat": "https://schema.org/EBook",
      "isAccessibleForFree": false,
      "audience": {
        "@type": "EducationalAudience",
        "educationalRole": "student",
      },
      "educationalLevel": level,
      "learningResourceType": "Bilingual reading book",
      // Год первой публикации оригинала — помогает Google связать страницу с
      // конкретным произведением, а не с одноимённым изданием или экранизацией.
      ...(book.year ? { "datePublished": String(book.year) } : {}),
      ...(stat?.pages ? { "numberOfPages": stat.pages } : {}),
      // Отрывок(и), реально опубликованные на странице — по одному на режим.
      ...((immersion || parallel) ? {
        "hasPart": [
          ...(immersion ? [{
            "@type": "CreativeWork",
            "name": `Отрывок «${name}» — режим погружения`,
            "isAccessibleForFree": true,
            "inLanguage": ["en", "ru"],
            "text": immersion.sentences.map((s: ExcerptSentence) => s.en).join(' '),
          }] : []),
          ...(parallel ? [{
            "@type": "CreativeWork",
            "name": `Отрывок «${name}» — параллельное чтение`,
            "isAccessibleForFree": true,
            "inLanguage": ["en", "ru"],
            "text": parallel.sentences.map((s: ExcerptSentence) => s.en).join(' '),
          }] : []),
        ],
      } : {}),
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": { "@type": "Answer", "text": item.a },
      })),
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://readling.club/" },
        { "@type": "ListItem", "position": 2, "name": "Книги", "item": "https://readling.club/books/" },
        { "@type": "ListItem", "position": 3, "name": name, "item": `https://readling.club/books/${slug}/` },
      ],
    })} />
  </Fragment>
</BaseLayout>

<style>
  .breadcrumbs {
    padding: var(--space-m) 0;
    font-size: 0.875rem;
    color: var(--color-text-tertiary);
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-card-border);
  }
  .breadcrumbs a { color: var(--color-text-tertiary); }
  .breadcrumbs a:hover { color: var(--color-primary); }
  .breadcrumbs__sep { margin: 0 var(--space-xs); }

  /* ── Отрывок: карточка-ридер ── */
  .excerpt-section { background: var(--color-surface-alt); }

  /* Когда у книги оба режима, отрывки идут друг за другом с подзаголовками. */
  .excerpt-mode + .excerpt-mode { margin-top: var(--space-xxl); }
  /* Одиночный параллельный ридер тянется на всю ширину, но рядом с ридером
     погружения (820px) это выглядело бы как ошибка вёрстки — выравниваем. */
  .excerpt-mode--paired .reader--parallel { max-width: 820px; }
  .excerpt-mode__title {
    font-size: 1.25rem;
    text-align: center;
    margin-bottom: var(--space-xs);
  }
  .excerpt-mode__hint {
    max-width: 60ch;
    margin: 0 auto var(--space-m);
    text-align: center;
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
  }

  .reader {
    max-width: 820px;
    margin: 0 auto;
    background: var(--color-surface);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }
  /* Параллельный режим — на всю ширину контейнера на больших экранах */
  .reader--parallel { max-width: 100%; }

  /* Шапка «окна» ридера */
  .reader__head {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-s) var(--space-l);
    background: var(--color-surface-alt);
    border-bottom: 1px solid var(--color-card-border);
  }
  .reader__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-card-border);
  }
  .reader__dot:nth-child(1) { background: #ff5f57; }
  .reader__dot:nth-child(2) { background: #febc2e; }
  .reader__dot:nth-child(3) { background: #28c840; }
  .reader__mode {
    margin-left: var(--space-s);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }
  .reader__level {
    margin-left: auto;
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--color-on-primary);
    background: var(--color-primary);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
  }

  /* Параллельный режим */
  .reader__colhead {
    display: grid;
    grid-template-columns: 1fr 1fr;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--color-text-tertiary);
    background: var(--color-surface-alt);
    border-bottom: 1px solid var(--color-card-border);
  }
  .reader__colhead span { padding: var(--space-xs) var(--space-l); }
  .reader__colhead span:first-child { border-right: 1px solid var(--color-card-border); }
  .prow {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .prow + .prow { border-top: 1px solid var(--color-card-border); }
  .prow__en,
  .prow__ru {
    padding: var(--space-sm) var(--space-l);
    font-size: 1rem;
    line-height: 1.6;
    margin: 0;
  }
  .prow__en {
    border-right: 1px solid var(--color-card-border);
    color: var(--color-text);
  }
  .prow__ru { color: var(--color-text-secondary); }
  .prow:hover { background: var(--color-primary-tint); }

  /* Режим погружения: страница книги */
  .reader__page { padding: var(--space-l) var(--space-xl); }
  .reader__text {
    font-size: 1.0625rem;
    line-height: 1.85;
    margin: 0 auto;
    max-width: 62ch;
    color: var(--color-text);
  }
  /* Английская фраза — кликабельный чип */
  .ph {
    font: inherit;
    color: var(--color-primary);
    font-weight: 600;
    background: var(--color-primary-tint);
    border: none;
    border-bottom: 1px dashed var(--color-primary);
    border-radius: var(--radius-sm);
    padding: 0 4px;
    margin: 0 1px;
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-out);
  }
  .ph:hover,
  .ph:focus-visible { background: var(--color-primary-tint-medium); outline: none; }
  .reader__tip {
    margin: var(--space-l) auto 0;
    max-width: 64ch;
    font-size: 0.875rem;
    color: var(--color-text-tertiary);
    text-align: center;
  }
  .ph--demo { cursor: default; border-bottom-style: dotted; }

  /* Тултип перевода */
  .ph-tooltip {
    position: absolute;
    z-index: 200;
    max-width: 280px;
    background: var(--color-text);
    color: var(--color-surface);
    font-size: 0.9375rem;
    line-height: 1.5;
    padding: var(--space-xs) var(--space-s);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-lg);
    pointer-events: none;
  }
  .ph-tooltip::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -5px;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: var(--color-text);
    border-bottom: 0;
  }

  .excerpt__note {
    max-width: 560px;
    margin: var(--space-l) auto var(--space-m);
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
  }

  @media (max-width: 768px) {
    .reader__colhead { display: none; }
    .prow { grid-template-columns: 1fr; }
    .prow__en {
      border-right: none;
      background: var(--color-primary-tint);
    }
    .reader__page { padding: var(--space-l) var(--space-l); }
    .reader__text { font-size: 1.0625rem; line-height: 1.95; }
  }

  .book-hero {
    background: var(--gradient-hero);
    padding: var(--space-xl) 0;
    border-bottom: 1px solid var(--color-card-border);
  }
  .book-hero__inner {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: var(--space-xl);
    align-items: start;
    margin-bottom: var(--space-xl);
  }
  .book-hero__cover img {
    width: 240px;
    height: auto;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
  }
  .book-hero h1 {
    font-size: 2rem;
    line-height: 1.15;
  }
  .book-hero__author {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    font-weight: 500;
  }
  /* Английский оригинал названия под H1 — у книг, объединённых из двух записей. */
  .book-hero__original {
    font-size: 1rem;
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-xs);
  }
  .book-hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }
  .tag {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 500;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    border: 1px solid var(--color-card-border);
    color: var(--color-text-secondary);
  }
  .tag--level {
    background: var(--color-primary);
    color: var(--color-on-primary);
    border-color: var(--color-primary);
    font-weight: 700;
