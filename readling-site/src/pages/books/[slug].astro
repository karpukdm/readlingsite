---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { links } from '../../config/links';
import allBooks from '../../data/books.json';
import { toSlug, complexityToLevel, genreLabels, genreVocabularyHints, extractSnippet } from '../../utils/slug';

export function getStaticPaths() {
  return allBooks
    .filter(b => !b.title.includes('Guide') && !b.title.includes('Руководство'))
    .map(book => ({
      params: { slug: toSlug(book.title) },
      props: { book },
    }));
}

const { book } = Astro.props;
const level = complexityToLevel[book.complexity] || 'B1';
const genres = book.genres.split(',').map((g: string) => g.trim());
const genreNames = genres.map((g: string) => genreLabels[g] || g).join(', ');
const isParallel = book.mode === 'параллельный';
const modeLabel = isParallel ? 'Параллельное чтение' : 'Режим погружения';
const slug = toSlug(book.title);

const levelDescription = book.complexity === 1 ? 'начальный' : book.complexity <= 3 ? 'средний' : book.complexity <= 5 ? 'продвинутый' : 'профессиональный';

// Related books: same genre or same level, excluding current
const otherBooks = allBooks.filter(b => !b.title.includes('Guide') && !b.title.includes('Руководство') && b.title !== book.title);
const bookGenres = new Set(genres);
// Prioritize same genre + same level, then same genre, then same level
const scored = otherBooks.map(b => {
  let score = 0;
  if (b.genres.split(',').some((g: string) => bookGenres.has(g.trim()))) score += 2;
  if (b.complexity === book.complexity) score += 1;
  if (Math.abs(b.complexity - book.complexity) === 1) score += 0.5;
  return { book: b, score };
}).filter(s => s.score > 0).sort((a, b) => b.score - a.score);
const relatedBooks = scored.slice(0, 6).map(s => s.book);

// Other books by the same author
const sameAuthorBooks = otherBooks.filter(b => b.author === book.author).slice(0, 4);

const primaryGenreCode = genres[0];
const primaryGenreLabel = genreLabels[primaryGenreCode] || primaryGenreCode;
const vocabularyHint = genreVocabularyHints[primaryGenreCode] || 'разнообразная лексика';

const pageTitle = `${book.title} (${book.author}) на английском с переводом — ${primaryGenreLabel}, уровень ${level} | Readling`;
const descriptionSnippet = extractSnippet(book.description, 110);
const pageDescription = `${descriptionSnippet} Читайте «${book.title}» на английском с русским переводом в Readling — ${isParallel ? 'параллельный режим' : 'режим погружения'}, уровень ${level}.`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={`/books/${slug}`}
  ogImage={book.imageUrl}
>
  <!-- BREADCRUMBS -->
  <nav class="breadcrumbs">
    <div class="container">
      <a href="/">Главная</a>
      <span class="breadcrumbs__sep">/</span>
      <a href="/books/">Книги</a>
      <span class="breadcrumbs__sep">/</span>
      <span>{book.title}</span>
    </div>
  </nav>

  <!-- HERO -->
  <section class="book-hero">
    <div class="container">
      <div class="book-hero__inner">
        <div class="book-hero__cover">
          <img src={book.imageUrl} alt={`Обложка книги «${book.title}»`} width="240" height="360" />
        </div>
        <div class="book-hero__info">
          <h1 class="mb-s">{book.title}</h1>
          <p class="book-hero__author mb-m">{book.author}</p>
          <div class="book-hero__tags mb-m">
            <span class="tag tag--level">{level}</span>
            <span class="tag tag--mode">{modeLabel}</span>
            {genres.map((g: string) => (
              <span class="tag">{genreLabels[g] || g}</span>
            ))}
          </div>
          <p class="book-hero__desc mb-m">{book.description}</p>
          <div class="store-buttons">
            <a href={links.appStore} target="_blank" rel="noopener" class="store-btn"><img src="/badge-appstore.svg" alt="Загрузите в App Store" /></a>
            <a href={links.googlePlay} target="_blank" rel="noopener" class="store-btn store-btn--google"><img src="/badge-google-play.png" alt="Доступно в Google Play" /></a>
          </div>
        </div>
      </div>
      <div class="facts-strip">
        <div class="fact"><span class="fact__label">Автор</span><span class="fact__value">{book.author}</span></div>
        <div class="fact"><span class="fact__label">Уровень</span><span class="fact__value">{level} · {levelDescription}</span></div>
        <div class="fact"><span class="fact__label">Жанр</span><span class="fact__value">{genreNames}</span></div>
        <div class="fact"><span class="fact__label">Режим чтения</span><span class="fact__value">{modeLabel}</span></div>
      </div>
    </div>
  </section>

  <!-- BODY: main + sticky sidebar -->
  <section class="section">
    <div class="container">
      <div class="book-body">
        <main class="book-body__main">
          <h2 class="mb-m">Зачем читать «{book.title}» на английском</h2>
          <ul class="benefits-list mb-xxl">
            <li>
              <strong>Лексика жанра «{primaryGenreLabel.toLowerCase()}».</strong>
              <span> В книге вас ждёт {vocabularyHint}. {book.complexity <= 2 ? 'Лексика подобрана так, чтобы её можно было освоить даже на старте обучения.' : book.complexity <= 4 ? 'Слова запоминаются в контексте живой истории, а не из учебных списков.' : 'Авторский стиль и редкая лексика помогут выйти на C1–C2.'}</span>
            </li>
            <li>
              <strong>{isParallel ? 'Грамматика через сравнение языков.' : 'Грамматика через погружение.'}</strong>
              <span> {isParallel ? 'В параллельном режиме «' + book.title + '» вы видите английскую и русскую версии рядом — удобно сравнивать порядок слов и конструкции, типичные для ' + book.author + '.' : 'В режиме погружения вы встречаете грамматические конструкции «' + book.title + '» десятки раз — мозг запоминает их без зубрёжки правил.'}</span>
            </li>
            <li>
              <strong>Уровень {level} — {levelDescription}.</strong>
              <span> {book.complexity <= 2 ? '«' + book.title + '» подходит тем, кто только начинает читать на английском. Простые предложения и частотная лексика.' : book.complexity <= 4 ? '«' + book.title + '» подходит читателям со средним уровнем — разнообразные конструкции и расширенный словарный запас.' : '«' + book.title + '» — для продвинутых читателей. Сложные конструкции, редкая лексика, узнаваемый стиль ' + book.author + '.'}</span>
            </li>
          </ul>

          <div class="callout">
            <div class="callout__title">Как читать «{book.title}» в Readling</div>
            <p class="callout__text">{isParallel ? 'Текст показывается параллельно: английский оригинал и русский перевод рядом, предложение за предложением. Нажмите на любое слово — увидите перевод и сохраните его в свой словарь для тренировок.' : 'Текст начинается почти полностью на русском. С каждой страницей английских слов становится больше — к концу книги вы читаете преимущественно на английском. Любое слово можно нажать для перевода и добавить в словарь.'}</p>
            <a href={isParallel ? '/parallelnoe-chtenie/' : '/metod-pogruzheniya/'} class="callout__link">{isParallel ? 'Подробнее о параллельном чтении' : 'Подробнее о методе погружения'} →</a>
          </div>
        </main>

        {sameAuthorBooks.length > 0 && (
          <aside class="book-body__sidebar">
            <div class="side-card">
              <div class="side-card__title side-card__title--sm">Другие книги {book.author}</div>
              <ul class="author-list">
                {sameAuthorBooks.map(ab => (
                  <li>
                    <a href={`/books/${toSlug(ab.title)}/`}>
                      <img src={ab.imageUrl} alt={ab.title} loading="lazy" />
                      <div class="author-list__meta">
                        <span class="author-list__title">{ab.title}</span>
                        <span class="author-list__level">{complexityToLevel[ab.complexity]}</span>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        )}
      </div>
    </div>
  </section>

  <!-- RELATED BOOKS -->
  {relatedBooks.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <h2 class="text-center mb-sm">Похожие книги уровня {level}</h2>
        <p class="text-center max-w-prose mx-auto mb-xl">
          Если вам нравится «{book.title}», попробуйте также эти книги в жанре {genreNames.split(',')[0].trim().toLowerCase()}.
        </p>
        <div class="related-grid">
          {relatedBooks.map(rb => (
            <a href={`/books/${toSlug(rb.title)}/`} class="related-book">
              <img class="related-book__cover" src={rb.imageUrl} alt={rb.title} loading="lazy" />
              <div class="related-book__info">
                <span class="related-book__level">{complexityToLevel[rb.complexity]}</span>
                <div class="related-book__title">{rb.title}</div>
                <div class="related-book__author">{rb.author}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="section">
    <div class="container max-w-wide mx-auto">
      <h2 class="text-center mb-l">Вопросы о чтении «{book.title}» на английском</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary>Можно ли читать «{book.title}» ({book.author}) бесплатно?</summary>
          <div class="faq-item__answer">
            Да, Readling предоставляет 7 дней бесплатного доступа ко всем книгам и функциям, включая «{book.title}». Скачайте приложение и начните читать.
          </div>
        </details>
        <details class="faq-item">
          <summary>Какой уровень английского нужен для «{book.title}»?</summary>
          <div class="faq-item__answer">
            «{book.title}» рассчитана на уровень {level} ({levelDescription}). {isParallel ? `В режиме параллельного чтения вы видите русский перевод рядом с каждым предложением — это помогает даже при уровне ниже ${level}.` : `В режиме погружения текст начинается почти полностью на русском и постепенно переходит на английский — поэтому книга комфортна даже при уровне ниже ${level}.`} {book.complexity <= 2 ? 'Это одна из самых простых книг в каталоге — отлично подойдёт для первого чтения на английском.' : book.complexity >= 5 ? 'Это книга для продвинутых читателей — сложная лексика и авторский стиль.' : ''}
          </div>
        </details>
        <details class="faq-item">
          <summary>Как читать «{book.title}» в {isParallel ? 'параллельном режиме' : 'режиме погружения'}?</summary>
          <div class="faq-item__answer">
            {isParallel
              ? `Откройте «${book.title}» в Readling — вы увидите английский оригинал и русский перевод рядом, предложение за предложением. Нажмите на любое слово для мгновенного перевода и добавления в словарь.`
              : `Откройте «${book.title}» в Readling — текст начнётся почти на русском. С каждой страницей английских слов будет больше. К концу книги вы будете читать преимущественно на английском.`}
          </div>
        </details>
        <details class="faq-item">
          <summary>Какой жанр у книги «{book.title}»?</summary>
          <div class="faq-item__answer">
            «{book.title}» ({book.author}) относится к жанрам: {genreNames}. В каталоге Readling есть и другие книги этих жанров — выбирайте по уровню и интересам.
          </div>
        </details>
        <details class="faq-item">
          <summary>Какую лексику я выучу, читая «{book.title}» на английском?</summary>
          <div class="faq-item__answer">
            «{book.title}» ({book.author}) принадлежит к жанру «{primaryGenreLabel.toLowerCase()}», поэтому вас ждёт {vocabularyHint}. {sameAuthorBooks.length > 0 ? `Если стиль ${book.author} вам близок — в Readling есть и другие его произведения.` : 'Каждое незнакомое слово сохраняется в личный словарь и закрепляется тренировками в приложении.'}
          </div>
        </details>
        <details class="faq-item">
          <summary>На каких устройствах можно читать «{book.title}»?</summary>
          <div class="faq-item__answer">
            Readling доступен на iPhone и Android-смартфонах. Скачайте бесплатно из App Store или Google Play и найдите «{book.title}» в каталоге.
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- Final compact CTA -->
  <section class="cta-final">
    <div class="container">
      <div class="cta-final__card">
        <div>
          <div class="cta-final__title">Начните читать «{book.title}» прямо сейчас</div>
          <div class="cta-final__subtitle">Первые 7 дней бесплатно</div>
        </div>
        <div class="store-buttons">
          <a href={links.appStore} target="_blank" rel="noopener" class="store-btn"><img src="/badge-appstore.svg" alt="Загрузите в App Store" /></a>
          <a href={links.googlePlay} target="_blank" rel="noopener" class="store-btn store-btn--google"><img src="/badge-google-play.png" alt="Доступно в Google Play" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Schema.org -->
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Book",
      "name": book.title,
      "author": { "@type": "Person", "name": book.author },
      "description": book.description,
      "image": book.imageUrl,
      "genre": genres.map((g: string) => genreLabels[g] || g),
      "inLanguage": "en",
      "audience": {
        "@type": "EducationalAudience",
        "educationalRole": "student",
        "suggestedMinAge": book.complexity <= 2 ? 10 : 14,
      },
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": `Можно ли читать «${book.title}» (${book.author}) бесплатно?`,
          "acceptedAnswer": { "@type": "Answer", "text": `Да, Readling предоставляет 7 дней бесплатного доступа ко всем книгам, включая «${book.title}».` }
        },
        {
          "@type": "Question",
          "name": `Какой уровень английского нужен для «${book.title}»?`,
          "acceptedAnswer": { "@type": "Answer", "text": `«${book.title}» рассчитана на уровень ${level} (${levelDescription}).` }
        },
        {
          "@type": "Question",
          "name": `Какой жанр у книги «${book.title}»?`,
          "acceptedAnswer": { "@type": "Answer", "text": `«${book.title}» (${book.author}) относится к жанрам: ${genreNames}.` }
        },
        {
          "@type": "Question",
          "name": `Какую лексику я выучу, читая «${book.title}» на английском?`,
          "acceptedAnswer": { "@type": "Answer", "text": `«${book.title}» относится к жанру «${primaryGenreLabel.toLowerCase()}», поэтому в книге встречается ${vocabularyHint}.` }
        },
        {
          "@type": "Question",
          "name": `На каких устройствах можно читать «${book.title}»?`,
          "acceptedAnswer": { "@type": "Answer", "text": "Readling доступен на iPhone и Android-смартфонах. Скачайте бесплатно из App Store или Google Play." }
        },
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://app.readling.club/" },
        { "@type": "ListItem", "position": 2, "name": "Книги", "item": "https://app.readling.club/books" },
        { "@type": "ListItem", "position": 3, "name": book.title, "item": `https://app.readling.club/books/${slug}` },
      ]
    })} />
  </Fragment>
</BaseLayout>

<style>
  .breadcrumbs {
    padding: var(--space-m) 0;
    font-size: 0.875rem;
    color: var(--color-text-tertiary);
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-card-border);
  }

  .breadcrumbs a {
    color: var(--color-text-tertiary);
  }

  .breadcrumbs a:hover {
    color: var(--color-primary);
  }

  .breadcrumbs__sep {
    margin: 0 var(--space-xs);
  }

  .book-hero {
    background: var(--gradient-hero);
    padding: var(--space-xl) 0;
    border-bottom: 1px solid var(--color-card-border);
  }

  .book-hero__inner {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: var(--space-xl);
    align-items: start;
    margin-bottom: var(--space-xl);
  }

  .book-hero__cover img {
    width: 240px;
    height: auto;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
  }

  .book-hero h1 {
    font-size: 2rem;
    line-height: 1.15;
  }

  .book-hero__author {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .book-hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .tag {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 500;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    border: 1px solid var(--color-card-border);
    color: var(--color-text-secondary);
  }

  .tag--level {
    background: var(--color-primary);
    color: var(--color-on-primary);
    border-color: var(--color-primary);
    font-weight: 700;
  }

  .tag--mode {
    background: var(--color-primary-tint);
    color: var(--color-primary);
    border-color: rgba(0, 122, 255, 0.2);
    font-weight: 600;
  }

  .book-hero__desc {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* ===== FACTS STRIP — replaces "О книге" 4-box section ===== */
  .facts-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-m);
    background: var(--color-surface);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-md);
    padding: var(--space-l) var(--space-xl);
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    min-width: 0;
  }

  .fact + .fact {
    border-left: 1px solid var(--color-card-border);
    padding-left: var(--space-xl);
  }

  .fact__label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-text-tertiary);
  }

  .fact__value {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ===== TWO-COLUMN BODY ===== */
  .book-body {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: var(--space-xl);
    align-items: start;
  }

  /* When no sidebar (no other books by author) — single centered column */
  .book-body:not(:has(.book-body__sidebar)) {
    grid-template-columns: minmax(0, 720px);
    justify-content: center;
  }

  .book-body__main h2 {
    font-size: 1.5rem;
  }

  /* ===== BENEFITS LIST — replaces 3-card grid ===== */
  .benefits-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
  }

  .benefits-list li {
    position: relative;
    padding-left: var(--space-l);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .benefits-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-primary);
  }

  .benefits-list strong {
    display: block;
    color: var(--color-text);
    font-weight: 600;
    font-size: 1.0625rem;
    margin-bottom: var(--space-xs);
  }

  /* ===== CALLOUT — replaces full mode-section ===== */
  .callout {
    background: var(--color-primary-tint);
    border: 1px solid rgba(0, 122, 255, 0.18);
    border-left: 3px solid var(--color-primary);
    border-radius: var(--radius-md);
    padding: var(--space-m) var(--space-l);
  }

  .callout__title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-xs);
  }

  .callout__text {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-s);
  }

  .callout__link {
    display: inline-block;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  /* ===== SIDEBAR ===== */
  .book-body__sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    position: sticky;
    top: calc(var(--header-height) + var(--space-m));
  }

  .side-card {
    background: var(--color-surface);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-md);
    padding: var(--space-l);
  }

  .side-card--cta {
    background: linear-gradient(135deg, #EBF4FF 0%, #FFF5F0 100%);
