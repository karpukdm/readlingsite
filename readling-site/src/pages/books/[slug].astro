---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { links } from '../../config/links';
import allBooks from '../../data/books.json';
import {
  toSlug,
  complexityToLevel,
  genreLabels,
  genreDescriptions,
  levelDescriptions,
  extractSnippet,
  coverPath,
  coverSrcset,
} from '../../utils/slug';

export function getStaticPaths() {
  return allBooks
    .filter(b => !b.title.includes('Guide') && !b.title.includes('Руководство'))
    .map(book => ({
      params: { slug: toSlug(book.title) },
      props: { book },
    }));
}

const { book } = Astro.props;
const complexity = book.complexity ?? 4;
const level = complexityToLevel[complexity] || 'B1';
const levelKey = level.toLowerCase();
const levelInfo = levelDescriptions[levelKey];
const genres = book.genres.split(',').map((g: string) => g.trim());
const genreNames = genres.map((g: string) => genreLabels[g] || g).join(', ');
const isParallel = book.mode === 'параллельный';
const modeLabel = isParallel ? 'Параллельное чтение' : 'Режим погружения';
const slug = toSlug(book.title);

const primaryGenreCode = genres[0];
const primaryGenreLabel = genreLabels[primaryGenreCode] || primaryGenreCode;
const primaryGenreInfo = genreDescriptions[primaryGenreCode];

// Похожие книги: по жанру + уровню
const otherBooks = allBooks.filter(
  b => !b.title.includes('Guide') && !b.title.includes('Руководство') && b.title !== book.title,
);
const bookGenres = new Set(genres);
const scored = otherBooks
  .map(b => {
    let score = 0;
    if (b.genres.split(',').some((g: string) => bookGenres.has(g.trim()))) score += 2;
    if (b.complexity === complexity) score += 1;
    if (Math.abs(b.complexity - complexity) === 1) score += 0.5;
    return { book: b, score };
  })
  .filter(s => s.score > 0)
  .sort((a, b) => b.score - a.score);
const relatedBooks = scored.slice(0, 6).map(s => s.book);

// Книги того же автора
const sameAuthorBooks = otherBooks.filter(b => b.author === book.author).slice(0, 4);

// Оценка объёма по описанию (грубая, но даёт уникальный контент)
const descLen = book.description.length;

// Слов в книге примерно (типичная длина)
const estimatedWords = complexity <= 2 ? '15–30 тыс.' : complexity <= 4 ? '50–80 тыс.' : '80–150 тыс.';
const estimatedReadingHours = complexity <= 2 ? '4–8' : complexity <= 4 ? '10–16' : '15–25';

// Уникальные «зачем читать» в зависимости от mode и complexity
const whyRead1 = isParallel
  ? `В параллельном режиме «${book.title}» вы видите английский оригинал ${book.author} рядом с русским переводом — предложение за предложением. Это идеальный способ разобрать авторский стиль ${book.author} и сравнить, как одни и те же мысли выражаются на двух языках.`
  : `В режиме погружения «${book.title}» начинается ${complexity <= 2 ? 'почти полностью на русском, и английский появляется постепенно — слово за словом, фраза за фразой' : complexity <= 4 ? 'с заметной долей английского — около 30–40% текста, и эта доля растёт к финалу' : 'с преобладанием английского — но все сложные конструкции остаются с подсказками, чтобы вы не потерялись в авторском стиле ' + book.author}. Это позволяет читать «${book.title}» даже на уровне ниже ${level} — и понимать каждый сюжетный поворот.`;

const whyRead2 = primaryGenreInfo
  ? `«${book.title}» относится к жанру «${primaryGenreLabel.toLowerCase()}», а это значит — ${primaryGenreInfo.vocab}. ${complexity <= 2 ? 'На уровне ' + level + ' эта лексика осваивается легко: повторов много, контекст понятный.' : complexity <= 4 ? 'На уровне ' + level + ' вы расширяете жанровый словарный запас и привыкаете к типичным конструкциям ' + primaryGenreLabel.toLowerCase() + '.' : 'На уровне ' + level + ' вы работаете с тонкостями жанра — стилем, регистром, идиомами, без которых «' + book.title + '» теряет вкус в переводе.'}`
  : `«${book.title}» — книга жанра «${primaryGenreLabel.toLowerCase()}». В жанровых произведениях лексика повторяется на протяжении всей книги, и слова усваиваются естественно через контекст.`;

const whyRead3 = `Читать «${book.title}» (${book.author}) на уровне ${level} — ${levelInfo?.short || ''}. ${
  complexity <= 2
    ? 'Это одна из самых доступных книг в каталоге Readling. Простые предложения, частотная лексика, повторяющиеся слова. Подходит даже тем, кто никогда не читал на английском.'
    : complexity <= 4
    ? 'Сбалансированная книга для уверенного перехода к чтению неадаптированной литературы. Ни слишком просто, ни слишком сложно.'
    : `Книга для опытных читателей. ${book.author} использует ${primaryGenreInfo?.vocab || 'богатую лексику'} — будет вызов и удовольствие.`
}`;

// Уникальная сводка для открывающего абзаца
const synopsisSnippet = extractSnippet(book.description, 110);
const pageTitle = `${book.title} (${book.author}) на английском с переводом — ${primaryGenreLabel}, уровень ${level} | Readling`;
const pageDescription = `${synopsisSnippet} Читайте «${book.title}» на английском с русским переводом в Readling — ${isParallel ? 'параллельный режим' : 'режим погружения'}, уровень ${level}.`;

// Тексты для FAQ (вычисляем в frontmatter, чтобы не использовать `<=` в JSX)
const previousLevel = complexityToLevel[Math.max(1, complexity - 1)];
const faqLevelAnswer = isParallel
  ? `В параллельном режиме рядом с английским всегда идёт русский перевод — это страховка для тех, кто пока не уверен в уровне ${level}.`
  : complexity <= 2
    ? `В режиме погружения текст начинается почти полностью на русском, поэтому «${book.title}» комфортна даже на уровне A1.`
    : `В режиме погружения сложность нарастает плавно — поэтому «${book.title}» доступна и читателям уровня ${previousLevel}, готовым к небольшому вызову.`;

// Парсинг чтения (для FAQ)
const readingHoursMax = parseInt(estimatedReadingHours.split('–')[1] || '8', 10);
const weeksMin = Math.ceil(readingHoursMax / 7);
const weeksMax = Math.ceil(readingHoursMax / 3);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={`/books/${slug}`}
  ogImage={`/og-books/${slug}.png`}
  ogType="book"
>
  <!-- BREADCRUMBS -->
  <nav class="breadcrumbs" aria-label="Хлебные крошки">
    <div class="container">
      <a href="/">Главная</a>
      <span class="breadcrumbs__sep">/</span>
      <a href="/books/">Книги</a>
      <span class="breadcrumbs__sep">/</span>
      <span>{book.title}</span>
    </div>
  </nav>

  <!-- HERO -->
  <section class="book-hero">
    <div class="container">
      <div class="book-hero__inner">
        <div class="book-hero__cover">
          <img src={coverPath(book.title, 'md')} srcset={coverSrcset(book.title, 'hero')} alt={`Обложка книги «${book.title}» — ${book.author}, ${primaryGenreLabel.toLowerCase()}, уровень ${level}`} width="240" height="360" fetchpriority="high" decoding="async" />
        </div>
        <div class="book-hero__info">
          <h1 class="mb-s">{book.title}</h1>
          <p class="book-hero__author mb-m">{book.author}</p>
          <div class="book-hero__tags mb-m">
            <span class="tag tag--level">{level}</span>
            <span class="tag tag--mode">{modeLabel}</span>
            {genres.map((g: string) => (
              <span class="tag">{genreLabels[g] || g}</span>
            ))}
          </div>
          <p class="book-hero__desc mb-m">{book.description}</p>
          <div class="store-buttons">
            <a href={links.appStore} target="_blank" rel="noopener" class="store-btn"><img src="/badge-appstore.svg" alt="Загрузите в App Store" /></a>
            <a href={links.googlePlay} target="_blank" rel="noopener" class="store-btn store-btn--google"><img src="/badge-google-play.png" alt="Доступно в Google Play" /></a>
          </div>
        </div>
      </div>
      <div class="facts-strip">
        <div class="fact"><span class="fact__label">Автор</span><span class="fact__value">{book.author}</span></div>
        <div class="fact"><span class="fact__label">Уровень</span><span class="fact__value">{level} · {levelInfo?.short || ''}</span></div>
        <div class="fact"><span class="fact__label">Объём</span><span class="fact__value">{estimatedWords} слов · ~{estimatedReadingHours} ч</span></div>
        <div class="fact"><span class="fact__label">Режим чтения</span><span class="fact__value">{modeLabel}</span></div>
      </div>
    </div>
  </section>

  <!-- BODY -->
  <section class="section">
    <div class="container">
      <div class="book-body">
        <main class="book-body__main">
          <h2 class="mb-m">Зачем читать «{book.title}» на английском</h2>
          <ul class="benefits-list mb-xl">
            <li>
              <strong>Режим «{modeLabel.toLowerCase()}» как раз для этой книги.</strong>
              <span> {whyRead1}</span>
            </li>
            <li>
              <strong>Лексика жанра «{primaryGenreLabel.toLowerCase()}».</strong>
              <span> {whyRead2}</span>
            </li>
            <li>
              <strong>Уровень {level} — {levelInfo?.short || 'оптимальный'}.</strong>
              <span> {whyRead3}</span>
            </li>
          </ul>

          <h2 class="mt-xxl mb-m">Как читать «{book.title}» в Readling</h2>
          <p class="mb-m">
            {isParallel
              ? `Откройте «${book.title}» в приложении и переключитесь в параллельный режим. Слева — английский оригинал ${book.author}, справа — русский перевод. Двигайтесь по книге в своём темпе. Если непонятно слово — нажмите на него: появится перевод и транскрипция, слово сохранится в личный словарь.`
              : `Откройте «${book.title}» в приложении и запустите режим погружения. ${complexity <= 2 ? 'На первых страницах текст почти полностью русский, английских слов 5–10%' : complexity <= 4 ? 'На первых страницах английского около 30–40%' : 'На первых страницах английского 60–80% — но сложные слова остаются с переводом'}. С каждой главой английского становится больше. К концу книги вы читаете преимущественно на английском — и сами не замечаете, как это произошло.`}
          </p>
          <p class="mb-l">
            Любое слово в тексте интерактивное: нажатие — мгновенный перевод и транскрипция. Слово сохраняется в ваш личный словарь, а потом приходит в тренировки — флэш-карточки, пазлы предложений, вставку слов. Так вы учите именно ту лексику, которая встретилась вам в «{book.title}», а не абстрактные списки из учебника.
          </p>

          <div class="callout">
            <div class="callout__title">{isParallel ? 'Совет: чередуйте параллельное чтение и погружение' : 'Совет: переключайтесь на параллельное чтение для сложных мест'}</div>
            <p class="callout__text">
              {isParallel
                ? `«${book.title}» — параллельный режим вашего основного маршрута. Если хотите попробовать иной подход — попробуйте режим погружения на другой книге того же автора.`
                : `Если в «${book.title}» вы встречаете непонятный абзац — на сложных книгах ${book.author} это нормально — переключитесь на параллельное чтение и разберите его. Потом вернитесь к погружению.`}
            </p>
            <a href={isParallel ? '/parallelnoe-chtenie/' : '/metod-pogruzheniya/'} class="callout__link">
              {isParallel ? 'Подробнее о параллельном чтении' : 'Подробнее о методе погружения'} →
            </a>
          </div>

          <h2 class="mt-xxl mb-m">«{book.title}» — что вы получите от чтения на английском</h2>
          <div class="learnings">
            <div class="learning">
              <div class="learning__num">01</div>
              <div>
                <h3>Лексика, которая остаётся надолго</h3>
                <p>Слова из «{book.title}» вы встречаете десятки раз — сначала в одной главе, потом в другой. Естественное повторение прочнее любых карточек: вы запоминаете слово вместе с ситуацией, эмоцией, персонажем.</p>
              </div>
            </div>
            <div class="learning">
              <div class="learning__num">02</div>
              <div>
                <h3>{isParallel ? 'Понимание авторского стиля' : 'Привычка к английскому ритму'}</h3>
                <p>{isParallel ? `Сравнивая оригинальные предложения ${book.author} с переводом, вы видите: где автор экономит слова, где использует длинные периоды, как строит диалоги. Это понимание стиля невозможно получить от учебника.` : `Чем дальше в «${book.title}», тем больше английского. Ваш мозг адаптируется к длинным фразам, начинает «слышать» английский ритм даже про себя. Через несколько глав чтение перестаёт быть переводом — становится просто чтением.`}</p>
              </div>
            </div>
            <div class="learning">
              <div class="learning__num">03</div>
              <div>
                <h3>Завершённая книга — а не брошенная на третьей странице</h3>
                <p>Главная проблема чтения в оригинале — бросить. {complexity <= 2 ? 'На уровне ' + level + ' Readling делает так, чтобы вы не сдались: вначале текст почти весь русский, бросать нечего.' : complexity <= 4 ? 'На уровне ' + level + ' Readling балансирует сложность: вам интересно, но не невозможно.' : 'На уровне ' + level + ' Readling помогает не утонуть в редкой лексике: подсказки приходят ровно тогда, когда нужны.'} В итоге «{book.title}» — это прочитанная книга, а не отложенный эксперимент.</p>
              </div>
            </div>
          </div>
        </main>

        {sameAuthorBooks.length > 0 && (
          <aside class="book-body__sidebar">
            <div class="side-card">
              <div class="side-card__title side-card__title--sm">Другие книги {book.author}</div>
              <ul class="author-list">
                {sameAuthorBooks.map(ab => (
                  <li>
                    <a href={`/books/${toSlug(ab.title)}/`}>
                      <img src={coverPath(ab.title, 'sm')} alt={ab.title} loading="lazy" decoding="async" width="40" height="60" />
                      <div class="author-list__meta">
                        <span class="author-list__title">{ab.title}</span>
                        <span class="author-list__level">{complexityToLevel[ab.complexity]}</span>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        )}
      </div>
    </div>
  </section>

  <!-- RELATED -->
  {relatedBooks.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <h2 class="text-center mb-sm">Похожие книги уровня {level}</h2>
        <p class="text-center max-w-prose mx-auto mb-xl">
          Если вам нравится «{book.title}», обратите внимание на эти книги в жанре {primaryGenreLabel.toLowerCase()} — они подобраны по уровню сложности и теме.
        </p>
        <div class="related-grid">
          {relatedBooks.map(rb => (
            <a href={`/books/${toSlug(rb.title)}/`} class="related-book">
              <img class="related-book__cover" src={coverPath(rb.title, 'sm')} srcset={coverSrcset(rb.title, 'card')} alt={`Обложка «${rb.title}»`} loading="lazy" decoding="async" width="160" height="240" />
              <div class="related-book__info">
                <span class="related-book__level">{complexityToLevel[rb.complexity]}</span>
                <div class="related-book__title">{rb.title}</div>
                <div class="related-book__author">{rb.author}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="section">
    <div class="container max-w-wide mx-auto">
      <h2 class="text-center mb-l">Вопросы о чтении «{book.title}» на английском</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary>Какой уровень английского нужен для «{book.title}»?</summary>
          <div class="faq-item__answer">
            «{book.title}» рассчитана на уровень {level} ({levelInfo?.short || ''}). {faqLevelAnswer}
          </div>
        </details>
        <details class="faq-item">
          <summary>Сколько времени занимает чтение «{book.title}»?</summary>
          <div class="faq-item__answer">
            Объём «{book.title}» — около {estimatedWords} слов. На уровне {level} среднестатистический читатель проходит её за {estimatedReadingHours} часов чистого времени — это {weeksMin}–{weeksMax} недель по 30 минут в день. Темп зависит от того, сколько слов вы переводите по дороге — а это, в свою очередь, зависит от уровня.
          </div>
        </details>
        <details class="faq-item">
          <summary>Можно ли читать «{book.title}» бесплатно?</summary>
          <div class="faq-item__answer">
            В Readling действует пробный период 7 дней — вы получаете доступ ко всем книгам каталога, включая «{book.title}», ко всем режимам чтения и тренировкам. После пробного периода никаких автосписаний — продолжать подписку или нет, решаете вы.
          </div>
        </details>
        <details class="faq-item">
          <summary>Какую лексику я выучу, читая «{book.title}»?</summary>
          <div class="faq-item__answer">
            «{book.title}» относится к жанру «{primaryGenreLabel.toLowerCase()}». {primaryGenreInfo?.vocab ? `Это значит — ${primaryGenreInfo.vocab}.` : 'Это значит — характерная для жанра лексика.'} Каждое слово, на которое вы нажмёте при чтении, попадёт в личный словарь. Дальше — тренировки именно на эту лексику: флэш-карточки, пазлы предложений, вставка слов.
          </div>
        </details>
        <details class="faq-item">
          <summary>Как переключаться между режимами чтения?</summary>
          <div class="faq-item__answer">
            У каждой книги в каталоге Readling есть основной режим. У «{book.title}» — это {isParallel ? 'параллельное чтение' : 'режим погружения'}. Если хотите попробовать другой режим — выбирайте книгу с этим режимом в каталоге; режим указан на карточке каждой книги.
          </div>
        </details>
        <details class="faq-item">
          <summary>На каких устройствах читать «{book.title}»?</summary>
          <div class="faq-item__answer">
            Readling работает на iPhone и Android-смартфонах. Скачайте бесплатно из App Store или Google Play, найдите «{book.title}» в каталоге и начните читать. Прогресс синхронизируется между устройствами по аккаунту.
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-final">
    <div class="container">
      <div class="cta-final__card">
        <div>
          <div class="cta-final__title">Начните читать «{book.title}» прямо сейчас</div>
          <div class="cta-final__subtitle">Первые 7 дней — бесплатно. Без автосписаний.</div>
        </div>
        <div class="store-buttons">
          <a href={links.appStore} target="_blank" rel="noopener" class="store-btn"><img src="/badge-appstore.svg" alt="Загрузите в App Store" /></a>
          <a href={links.googlePlay} target="_blank" rel="noopener" class="store-btn store-btn--google"><img src="/badge-google-play.png" alt="Доступно в Google Play" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Schema.org -->
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Book",
      "name": book.title,
      "author": { "@type": "Person", "name": book.author },
      "description": book.description,
      "image": `https://readling.club${coverPath(book.title, 'lg')}`,
      "url": `https://readling.club/books/${slug}/`,
      "genre": genres.map((g: string) => genreLabels[g] || g),
      "inLanguage": ["en", "ru"],
      "bookFormat": "https://schema.org/EBook",
      "isAccessibleForFree": false,
      "audience": {
        "@type": "EducationalAudience",
        "educationalRole": "student",
      },
      "educationalLevel": level,
      "learningResourceType": "Bilingual reading book",
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": `Какой уровень английского нужен для «${book.title}»?`,
