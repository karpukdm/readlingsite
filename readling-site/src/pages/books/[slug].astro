---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { links } from '../../config/links';
import allBooks from '../../data/books.json';
import excerpts from '../../data/excerpts.json';
import bookStats from '../../data/book-stats.json';
import {
  toSlug,
  complexityToLevel,
  genreLabels,
  genreDescriptions,
  levelDescriptions,
  extractSnippet,
  coverPath,
  coverSrcset,
} from '../../utils/slug';

export function getStaticPaths() {
  return allBooks
    .filter(b => !b.title.includes('Guide') && !b.title.includes('Руководство'))
    .map(book => ({
      params: { slug: toSlug(book.title) },
      props: { book },
    }));
}

const { book } = Astro.props;
const complexity = book.complexity ?? 4;
const level = complexityToLevel[complexity] || 'B1';
const levelKey = level.toLowerCase();
const levelInfo = levelDescriptions[levelKey];
const genres = book.genres.split(',').map((g: string) => g.trim());
const genreNames = genres.map((g: string) => genreLabels[g] || g).join(', ');
const isParallel = book.mode === 'параллельный';
const modeLabel = isParallel ? 'Параллельное чтение' : 'Режим погружения';
const slug = toSlug(book.title);

// Отрывок книги (первые ~2 страницы) из БД приложения — см. scripts/export-excerpts.mjs.
type ExcerptPhrase = { ru: string; en: string; cx: number };
type ExcerptSentence = { en: string; ru: string; phrases: ExcerptPhrase[] };
type Excerpt = { mode: 'parallel' | 'immersion'; sentences: ExcerptSentence[] };
const excerpt = (excerpts as Record<string, Excerpt>)[slug] ?? null;

// Доля английского для показа режима погружения — как ранняя ступень в приложении.
const IMMERSION_SHARE = 0.25;
const wordCount = (s: string) => s.split(/\s+/).filter(Boolean).length;

// Плетение одного предложения: простые фразы (низкий complexity) переходят на английский
// первыми, пока доля английских слов не достигнет IMMERSION_SHARE — тот же принцип, что в приложении.
function weaveSentence(sent: ExcerptSentence) {
  const ph = sent.phrases;
  const tail = (sent.ru.match(/[.!?…»)]+$/) || [''])[0];
  if (!ph || ph.length === 0) return { tokens: [{ t: sent.ru, en: false }], tail: '' };
  const total = ph.reduce((n, p) => n + wordCount(p.ru), 0) || 1;
  const order = ph.map((p, i) => ({ i, cx: p.cx })).sort((a, b) => a.cx - b.cx || a.i - b.i);
  const enSet = new Set<number>();
  let enW = 0;
  for (const { i } of order) {
    if (enW / total >= IMMERSION_SHARE) break;
    enSet.add(i);
    enW += wordCount(ph[i].ru);
  }
  const tokens = ph.map((p, i) => {
    if (!enSet.has(i)) return { t: p.ru, en: false, ru: '' };
    let t = p.en;
    // не-первую английскую фразу пишем со строчной, если русский аналог строчный
    // (так имена собственные — «Winston Smith» — остаются с заглавной)
    if (i > 0 && /^[а-яё]/.test(p.ru)) t = t.charAt(0).toLowerCase() + t.slice(1);
    return { t, en: true, ru: p.ru };
  });
  return { tokens, tail };
}

const isParallelExcerpt = excerpt?.mode === 'parallel';
const immersionData = excerpt && !isParallelExcerpt ? excerpt.sentences.map(weaveSentence) : [];

const primaryGenreCode = genres[0];
const primaryGenreLabel = genreLabels[primaryGenreCode] || primaryGenreCode;
const primaryGenreInfo = genreDescriptions[primaryGenreCode];

// Похожие книги: по жанру + уровню
const otherBooks = allBooks.filter(
  b => !b.title.includes('Guide') && !b.title.includes('Руководство') && b.title !== book.title,
);
const bookGenres = new Set(genres);
const scored = otherBooks
  .map(b => {
    let score = 0;
    if (b.genres.split(',').some((g: string) => bookGenres.has(g.trim()))) score += 2;
    if (b.complexity === complexity) score += 1;
    if (Math.abs(b.complexity - complexity) === 1) score += 0.5;
    return { book: b, score };
  })
  .filter(s => s.score > 0)
  .sort((a, b) => b.score - a.score);
const relatedBooks = scored.slice(0, 6).map(s => s.book);

// Книги того же автора
const sameAuthorBooks = otherBooks.filter(b => b.author === book.author).slice(0, 4);

// Реальные данные книги (объём) — уникальны для каждой книги, держат текст не-шаблонным.
const stat = (bookStats as Record<string, { pages: number; chapters: number }>)[slug] ?? null;
function plural(n: number, one: string, few: string, many: string) {
  const m10 = n % 10, m100 = n % 100;
  if (m10 === 1 && m100 !== 11) return one;
  if (m10 >= 2 && m10 <= 4 && (m100 < 10 || m100 >= 20)) return few;
  return many;
}
const pagesPhrase = stat?.pages ? `${stat.pages} ${plural(stat.pages, 'страница', 'страницы', 'страниц')}` : '';

// Блок «Зачем читать» — мотивирующий: жанровый крючок + посильная цель + что получишь.
const modeReassurance = isParallel
  ? 'русский перевод всегда рядом — вы не застрянете на трудной фразе и не бросите на середине'
  : 'английский входит в текст постепенно, и вы втягиваетесь незаметно — без барьера «слишком сложно»';
const whyHook = `${primaryGenreInfo?.appeal || 'Прочитать любимую историю в оригинале — отдельное удовольствие, которого не даёт перевод.'} И «${book.title}» ${book.author ? `(${book.author}) ` : ''}на английском — это посильная цель:${pagesPhrase ? ` ${pagesPhrase}` : ''} на уровне ${level} (${levelInfo?.short || ''}), где ${modeReassurance}.`;
const whyPayoff = primaryGenreInfo?.vocab
  ? `А дочитав «${book.title}» до конца, вы не просто закроете книгу в оригинале — попутно освоите характерную лексику жанра (${primaryGenreInfo.vocab}), причём не зубрёжкой, а вместе с сюжетом.`
  : `А дочитав «${book.title}» до конца, вы закроете настоящую книгу в оригинале — и почувствуете язык совсем иначе, чем на учебных текстах.`;

// Уникальная сводка для открывающего абзаца
const synopsisSnippet = extractSnippet(book.description, 110);
const pageTitle = `${book.title} (${book.author}) на английском с переводом — ${primaryGenreLabel}, уровень ${level} | Readling`;
const pageDescription = `${synopsisSnippet} Читайте «${book.title}» на английском с русским переводом в Readling — ${isParallel ? 'параллельный режим' : 'режим погружения'}, уровень ${level}.`;

// H1 и лид-абзац под ключевые запросы («[книга] на английском с [параллельным] переводом»)
const translationPhrase = isParallel ? 'с параллельным переводом' : 'с переводом';
const pageH1 = `${book.title} на английском ${translationPhrase}`;
const heroLead = isParallel
  ? `«${book.title}» (${book.author}) — читать на английском с параллельным русским переводом онлайн: английский оригинал и перевод рядом. ${primaryGenreLabel}, уровень ${level}.`
  : `«${book.title}» (${book.author}) — читать на английском с русским переводом онлайн в режиме погружения. ${primaryGenreLabel}, уровень ${level}.`;

// Тексты для FAQ (вычисляем в frontmatter, чтобы не использовать `<=` в JSX)
const previousLevel = complexityToLevel[Math.max(1, complexity - 1)];
const faqLevelAnswer = isParallel
  ? `В параллельном режиме рядом с английским всегда идёт русский перевод — это страховка для тех, кто пока не уверен в уровне ${level}.`
  : complexity <= 2
    ? `В режиме погружения текст начинается почти полностью на русском, поэтому «${book.title}» комфортна даже на уровне A1.`
    : `В режиме погружения сложность нарастает плавно — поэтому «${book.title}» доступна и читателям уровня ${previousLevel}, готовым к небольшому вызову.`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={`/books/${slug}`}
  ogImage={`/og-books/${slug}.png`}
  ogType="book"
>
  <!-- BREADCRUMBS -->
  <nav class="breadcrumbs" aria-label="Хлебные крошки">
    <div class="container">
      <a href="/">Главная</a>
      <span class="breadcrumbs__sep">/</span>
      <a href="/books/">Книги</a>
      <span class="breadcrumbs__sep">/</span>
      <span>{book.title}</span>
    </div>
  </nav>

  <!-- HERO -->
  <section class="book-hero">
    <div class="container">
      <div class="book-hero__inner">
        <div class="book-hero__cover">
          <img src={coverPath(book.title, 'md')} srcset={coverSrcset(book.title, 'hero')} alt={`Обложка книги «${book.title}» — ${book.author}, ${primaryGenreLabel.toLowerCase()}, уровень ${level}`} width="240" height="360" fetchpriority="high" decoding="async" />
        </div>
        <div class="book-hero__info">
          <h1 class="mb-s">{pageH1}</h1>
          <p class="book-hero__author mb-m">{book.author}</p>
          <div class="book-hero__tags mb-m">
            <span class="tag tag--level">{level}</span>
            <span class="tag tag--mode">{modeLabel}</span>
            {genres.map((g: string) => (
              <span class="tag">{genreLabels[g] || g}</span>
            ))}
          </div>
          <p class="book-hero__lead mb-m">{heroLead}</p>
          <p class="book-hero__desc mb-m">{book.description}</p>
          <div class="store-buttons">
            <a href={links.appStore} target="_blank" rel="noopener" class="store-btn"><img src="/badge-appstore.svg" alt="Загрузите в App Store" /></a>
            <a href={links.googlePlay} target="_blank" rel="noopener" class="store-btn store-btn--google"><img src="/badge-google-play.png" alt="Доступно в Google Play" /></a>
          </div>
        </div>
      </div>
      <div class="facts-strip">
        <div class="fact"><span class="fact__label">Автор</span><span class="fact__value">{book.author}</span></div>
        <div class="fact"><span class="fact__label">Уровень</span><span class="fact__value">{level} · {levelInfo?.short || ''}</span></div>
        <div class="fact"><span class="fact__label">Жанр</span><span class="fact__value">{primaryGenreLabel}</span></div>
        <div class="fact"><span class="fact__label">Режим чтения</span><span class="fact__value">{modeLabel}</span></div>
      </div>
    </div>
  </section>

  <!-- EXCERPT (реальный отрывок книги в её режиме чтения) -->
  {excerpt && (
    <section class="section excerpt-section" aria-labelledby="excerpt-title">
      <div class="container mx-auto">
        <h2 id="excerpt-title" class="text-center mb-sm">
          Отрывок «{book.title}» — {isParallelExcerpt ? 'параллельное чтение' : 'режим погружения'}
        </h2>
        <p class="text-center max-w-prose mx-auto mb-l">
          {isParallelExcerpt
            ? 'Первая страница книги в параллельном режиме: английский оригинал и русский перевод рядом — так это выглядит в приложении Readling.'
            : 'Первая страница книги в режиме погружения: английский вплетён в русский текст. Здесь около 25% английского — в приложении его доля растёт с каждой главой.'}
        </p>

        <div class={`reader ${isParallelExcerpt ? 'reader--parallel' : 'reader--immersion'}`}>
          <div class="reader__head">
            <span class="reader__dot" aria-hidden="true"></span>
            <span class="reader__dot" aria-hidden="true"></span>
            <span class="reader__dot" aria-hidden="true"></span>
            <span class="reader__mode">{isParallelExcerpt ? 'Параллельный режим' : 'Режим погружения'}</span>
            <span class="reader__level">{level}</span>
          </div>

          {isParallelExcerpt ? (
            <div class="reader__cols">
              <div class="reader__colhead" aria-hidden="true">
                <span>English</span>
                <span>Русский</span>
              </div>
              {excerpt.sentences.map((s: ExcerptSentence) => (
                <div class="prow">
                  <p class="prow__en" lang="en">{s.en}</p>
                  <p class="prow__ru" lang="ru">{s.ru}</p>
                </div>
              ))}
            </div>
          ) : (
            <div class="reader__page">
              <p class="reader__text" lang="ru">
                {immersionData.map(({ tokens, tail }) => (
                  <Fragment>
                    {tokens.map((tok, idx) => (
                      <Fragment>
                        {idx > 0 ? ' ' : ''}
                        {tok.en
                          ? <button type="button" class="ph" lang="en" data-ru={tok.ru} aria-label={`${tok.t} — перевод: ${tok.ru}`}>{tok.t}</button>
                          : tok.t}
                      </Fragment>
                    ))}
                    {tail}{' '}
                  </Fragment>
                ))}
              </p>
              <p class="reader__tip">Нажмите на <span class="ph ph--demo">английскую фразу</span>, чтобы увидеть перевод</p>
            </div>
          )}
        </div>

        <p class="excerpt__note text-center">
          Это начало «{book.title}». Полный текст с переводом по нажатию на любое слово, личным словарём
          и тренировками — в приложении Readling.
        </p>
        <div class="store-buttons" style="justify-content: center;">
          <a href={links.appStore} target="_blank" rel="noopener" class="store-btn"><img src="/badge-appstore.svg" alt="Загрузите в App Store" /></a>
          <a href={links.googlePlay} target="_blank" rel="noopener" class="store-btn store-btn--google"><img src="/badge-google-play.png" alt="Доступно в Google Play" /></a>
        </div>
      </div>

      {/* Тултип перевода для режима погружения */}
      <div id="ph-tooltip" class="ph-tooltip" role="tooltip" hidden></div>
      <script is:inline>
        (() => {
          const tip = document.getElementById('ph-tooltip');
          if (!tip) return;
          let open = null;
          const hide = () => { tip.hidden = true; open = null; };
          const show = (el) => {
            const ru = el.getAttribute('data-ru');
            if (!ru) return;
            tip.textContent = ru;
            tip.hidden = false;
            const r = el.getBoundingClientRect();
            const tr = tip.getBoundingClientRect();
            let left = r.left + window.scrollX + r.width / 2 - tr.width / 2;
            left = Math.max(8 + window.scrollX, Math.min(left, window.scrollX + document.documentElement.clientWidth - tr.width - 8));
            tip.style.left = left + 'px';
            tip.style.top = (r.top + window.scrollY - tr.height - 8) + 'px';
            open = el;
          };
          document.addEventListener('click', (e) => {
            const el = e.target.closest('.reader__text .ph');
            if (el) {
              e.preventDefault();
              if (open === el) { hide(); } else { show(el); }
            } else if (!e.target.closest('#ph-tooltip')) {
              hide();
            }
          });
          window.addEventListener('scroll', hide, { passive: true });
          window.addEventListener('resize', hide);
        })();
      </script>
    </section>
  )}

  <!-- BODY -->
  <section class="section">
    <div class="container">
      <div class="book-body">
        <main class="book-body__main">
          <h2 class="mb-m">Зачем читать «{book.title}» на английском</h2>
          <p class="mb-m">{whyHook}</p>
          <p class="mb-l">{whyPayoff}</p>

          <p class="book-body__more">
            Подробнее о режимах чтения: <a href="/parallelnoe-chtenie/">параллельное чтение</a> и <a href="/metod-pogruzheniya/">метод погружения</a>.
          </p>
        </main>

        {sameAuthorBooks.length > 0 && (
          <aside class="book-body__sidebar">
            <div class="side-card">
              <div class="side-card__title side-card__title--sm">Другие книги {book.author}</div>
              <ul class="author-list">
                {sameAuthorBooks.map(ab => (
                  <li>
                    <a href={`/books/${toSlug(ab.title)}/`}>
                      <img src={coverPath(ab.title, 'sm')} alt={ab.title} loading="lazy" decoding="async" width="40" height="60" />
                      <div class="author-list__meta">
                        <span class="author-list__title">{ab.title}<span class="visually-hidden"> на английском {ab.mode === 'параллельный' ? 'с параллельным переводом' : 'с переводом'}</span></span>
                        <span class="author-list__level">{complexityToLevel[ab.complexity]}</span>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        )}
      </div>
    </div>
  </section>

  <!-- RELATED -->
  {relatedBooks.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <h2 class="text-center mb-sm">Похожие книги уровня {level}</h2>
        <p class="text-center max-w-prose mx-auto mb-xl">
          Если вам нравится «{book.title}», обратите внимание на эти книги в жанре {primaryGenreLabel.toLowerCase()} — они подобраны по уровню сложности и теме.
        </p>
        <div class="related-grid">
          {relatedBooks.map(rb => (
            <a href={`/books/${toSlug(rb.title)}/`} class="related-book">
              <img class="related-book__cover" src={coverPath(rb.title, 'sm')} srcset={coverSrcset(rb.title, 'card')} alt={`Обложка «${rb.title}»`} loading="lazy" decoding="async" width="160" height="240" />
              <div class="related-book__info">
                <span class="related-book__level">{complexityToLevel[rb.complexity]}</span>
                <div class="related-book__title">{rb.title}<span class="visually-hidden"> на английском {rb.mode === 'параллельный' ? 'с параллельным переводом' : 'с переводом'}</span></div>
                <div class="related-book__author">{rb.author}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="section">
    <div class="container max-w-wide mx-auto">
      <h2 class="text-center mb-l">Вопросы о чтении «{book.title}» на английском</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary>Какой уровень английского нужен для «{book.title}»?</summary>
          <div class="faq-item__answer">
            «{book.title}» рассчитана на уровень {level} ({levelInfo?.short || ''}). {faqLevelAnswer}
          </div>
        </details>
        <details class="faq-item">
          <summary>Можно ли читать «{book.title}» бесплатно?</summary>
          <div class="faq-item__answer">
            В Readling действует пробный период 7 дней — вы получаете доступ ко всем книгам каталога, включая «{book.title}», ко всем режимам чтения и тренировкам. После пробного периода никаких автосписаний — продолжать подписку или нет, решаете вы.
          </div>
        </details>
        <details class="faq-item">
          <summary>Какую лексику я выучу, читая «{book.title}»?</summary>
          <div class="faq-item__answer">
            «{book.title}» относится к жанру «{primaryGenreLabel.toLowerCase()}». {primaryGenreInfo?.vocab ? `Это значит — ${primaryGenreInfo.vocab}.` : 'Это значит — характерная для жанра лексика.'} Каждое слово, на которое вы нажмёте при чтении, попадёт в личный словарь. Дальше — тренировки именно на эту лексику: флэш-карточки, пазлы предложений, вставка слов.
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-final">
    <div class="container">
      <div class="cta-final__card">
        <div>
          <div class="cta-final__title">Начните читать «{book.title}» прямо сейчас</div>
          <div class="cta-final__subtitle">Первые 7 дней — бесплатно. Без автосписаний.</div>
        </div>
        <div class="store-buttons">
          <a href={links.appStore} target="_blank" rel="noopener" class="store-btn"><img src="/badge-appstore.svg" alt="Загрузите в App Store" /></a>
          <a href={links.googlePlay} target="_blank" rel="noopener" class="store-btn store-btn--google"><img src="/badge-google-play.png" alt="Доступно в Google Play" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Schema.org -->
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Book",
      "name": book.title,
      "author": { "@type": "Person", "name": book.author },
      "description": book.description,
      "image": `https://readling.club${coverPath(book.title, 'lg')}`,
      "url": `https://readling.club/books/${slug}/`,
      "genre": genres.map((g: string) => genreLabels[g] || g),
      "inLanguage": ["en", "ru"],
      "bookFormat": "https://schema.org/EBook",
      "isAccessibleForFree": false,
      "audience": {
        "@type": "EducationalAudience",
        "educationalRole": "student",
      },
      "educationalLevel": level,
      "learningResourceType": "Bilingual reading book",
      ...(excerpt ? {
        "hasPart": {
          "@type": "CreativeWork",
          "name": `Отрывок «${book.title}» на английском с переводом`,
          "isAccessibleForFree": true,
          "inLanguage": ["en", "ru"],
          "text": excerpt.sentences.map((s: ExcerptSentence) => s.en).join(' '),
        },
      } : {}),
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": `Какой уровень английского нужен для «${book.title}»?`,
          "acceptedAnswer": { "@type": "Answer", "text": `«${book.title}» рассчитана на уровень ${level} (${levelInfo?.short || ''}). В режиме ${isParallel ? 'параллельного чтения' : 'погружения'} книга комфортна даже на уровне ниже.` },
        },
        {
          "@type": "Question",
