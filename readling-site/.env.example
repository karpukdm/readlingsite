# Переменные должны быть заданы в настройках сборки Cloudflare
# (Workers → readlingsite → Settings → Variables), а не только локально:
# иначе на продакшене их нет и соответствующая разметка не выводится.
# Именно поэтому на readling.club сейчас нет ни Метрики, ни GA.

# Yandex.Metrika counter ID (digits only, e.g. 12345678)
# Get one at https://metrika.yandex.ru/
PUBLIC_YM_ID=

# Google Analytics 4 Measurement ID (format G-XXXXXXXXXX)
# Get one at https://analytics.google.com/
PUBLIC_GA_ID=

# Подтверждение прав в Google Search Console: значение атрибута content
# из меты, которую даёт способ подтверждения «HTML-тег».
# https://search.google.com/search-console
PUBLIC_GSC_VERIFICATION=

# Подтверждение прав в Яндекс.Вебмастере: значение content меты yandex-verification.
# https://webmaster.yandex.ru/
PUBLIC_YANDEX_VERIFICATION=

# Подтверждение прав в Bing Webmaster Tools: значение content меты msvalidate.01
# (способ подтверждения «HTML Meta Tag»). Нужен ради отчёта AI Performance —
# он показывает, какие URL сайта цитирует Copilot и по каким запросам; в Google
# такого отчёта нет, и без Bing про AI-видимость остаётся только гадать.
# https://www.bing.com/webmasters/ — сайт можно импортировать из Search Console,
# но подтверждение всё равно нужно своё.
PUBLIC_BING_VERIFICATION=
