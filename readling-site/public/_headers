/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=(), browsing-topics=()
  X-Frame-Options: SAMEORIGIN

# Static assets — длинный кэш
/_assets/*
  Cache-Control: public, max-age=31536000, immutable

/covers/*
  Cache-Control: public, max-age=31536000, immutable

/og-books/*
  Cache-Control: public, max-age=2592000

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

# HTML — короткий кэш, чтобы быстро видеть обновления.
# Правило /*.html не срабатывало: страницы отдаются по /books/1984/, а не
# /books/1984/index.html, поэтому HTML перечислен здесь путями каталогов.
/
  Cache-Control: public, max-age=300, must-revalidate

/books/*
  Cache-Control: public, max-age=300, must-revalidate

/uroven/*
  Cache-Control: public, max-age=300, must-revalidate

/sravnenie/*
  Cache-Control: public, max-age=300, must-revalidate

/metod-pogruzheniya/*
  Cache-Control: public, max-age=300, must-revalidate

/parallelnoe-chtenie/*
  Cache-Control: public, max-age=300, must-revalidate

/pricing/*
  Cache-Control: public, max-age=300, must-revalidate

/o-readling/*
  Cache-Control: public, max-age=300, must-revalidate

# Sitemap и robots — обновляются с каждым деплоем
/sitemap-index.xml
  Cache-Control: public, max-age=3600

/sitemap-0.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600
